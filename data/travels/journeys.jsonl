{"id":"route:journey:ibn_battuta","kind":"route","subtype":"journey","name":"Ibn Battuta's travels","carrier":"person:ibn_battuta","lenses":["people","geography"],"start":1325,"end":1354,"what":"Twenty-nine years and about 117,000 km across the Islamic world, India, China and West Africa (1325-1354).","legs":[{"from":"place:tangier","to":"place:tlemcen","mode":"caravan","conf":"estimated","start_date":"1325-06-14","end_date":"1325-07"},{"from":"place:tlemcen","to":"place:bejaia","mode":"caravan","conf":"estimated","start_date":"1325-07","end_date":"1325-08","note":"falls ill with fever"},{"from":"place:bejaia","to":"place:tunis","mode":"caravan","conf":"attested","start_date":"1325-08","end_date":"1325-09","note":"two months; joins the pilgrim caravan as its qadi"},{"from":"place:tunis","to":"place:tripoli","mode":"caravan","conf":"estimated","start_date":"1325-11","end_date":"1326-01","note":"marries for the first time on the road"},{"from":"place:tripoli","to":"place:alexandria","mode":"caravan","conf":"attested","start_date":"1326-02","end_date":"1326-04-05","note":"sees the Pharos lighthouse, partly ruined"},{"from":"place:alexandria","to":"place:cairo","mode":"land","conf":"attested","start_date":"1326-04","end_date":"1326-05","note":"the \"mother of cities\"; about a month"},{"from":"place:cairo","to":"place:aydhab","mode":"river","conf":"estimated","start_date":"1326-06","end_date":"1326-07","note":"war on the Red Sea coast blocks the crossing; turns back"},{"from":"place:aydhab","to":"place:damascus","mode":"land","conf":"attested","start_date":"1326-07","end_date":"1326-08-09","note":"Ramadan in Damascus; studies with its scholars"},{"from":"place:damascus","to":"place:medina","mode":"caravan","conf":"attested","start_date":"1326-09-01","end_date":"1326-10"},{"from":"place:medina","to":"place:mecca","mode":"caravan","conf":"attested","start_date":"1326-10","end_date":"1326-10-22","note":"first hajj"},{"from":"place:mecca","to":"place:najaf","mode":"caravan","conf":"estimated","start_date":"1326-11-17","end_date":"1326-12","note":"with the Iraqi pilgrim caravan"},{"from":"place:najaf","to":"place:basra","mode":"land","conf":"estimated","start_date":"1327-01","end_date":"1327-01"},{"from":"place:basra","to":"place:isfahan","mode":"land","conf":"estimated","start_date":"1327-02","end_date":"1327-03"},{"from":"place:isfahan","to":"place:shiraz","mode":"land","conf":"estimated","start_date":"1327-03","end_date":"1327-04","note":"meets the scholar Majd al-Din"},{"from":"place:shiraz","to":"place:baghdad","mode":"land","conf":"attested","start_date":"1327-04","end_date":"1327-06","note":"joins the camp of the Ilkhan Abu Said"},{"from":"place:baghdad","to":"place:tabriz","mode":"horse","conf":"attested","start_date":"1327-06","end_date":"1327-06","note":"ten days with the Ilkhan's court"},{"from":"place:tabriz","to":"place:mosul","mode":"land","conf":"estimated","start_date":"1327-07","end_date":"1327-08"},{"from":"place:mosul","to":"place:mecca","mode":"caravan","conf":"estimated","start_date":"1327-08","end_date":"1327-11","note":"about three years in Mecca, studying (Dunn puts it at one year, to 1328)"},{"from":"place:mecca","to":"place:aden","mode":"sea","conf":"estimated","start_date":"1330-09","end_date":"1331-01"},{"from":"place:aden","to":"place:mogadishu","mode":"sea","conf":"attested","start_date":"1331-01","end_date":"1331-02","note":"a Swahili sultan's hospitality"},{"from":"place:mogadishu","to":"place:mombasa","mode":"sea","conf":"attested","start_date":"1331-02","end_date":"1331-02"},{"from":"place:mombasa","to":"place:kilwa","mode":"sea","conf":"attested","start_date":"1331-02","end_date":"1331-03","note":"\"one of the finest and best-built towns\""},{"from":"place:kilwa","to":"place:salalah","mode":"sea","conf":"estimated","start_date":"1331-04","end_date":"1331-06","note":"on the monsoon"},{"from":"place:salalah","to":"place:hormuz","mode":"sea","conf":"estimated","start_date":"1331-06","end_date":"1331-09"},{"from":"place:hormuz","to":"place:mecca","mode":"caravan","conf":"estimated","start_date":"1331-09","end_date":"1332-02","note":"another hajj; resolves to seek service in India"},{"from":"place:mecca","to":"place:alanya","mode":"sea","conf":"estimated","start_date":"1332-03","end_date":"1332-05","note":"Anatolia: guest of the akhi brotherhoods"},{"from":"place:alanya","to":"place:konya","mode":"land","conf":"estimated","start_date":"1332-05","end_date":"1332-06"},{"from":"place:konya","to":"place:sinop_ancient","mode":"land","conf":"estimated","start_date":"1332-06","end_date":"1332-08"},{"from":"place:sinop_ancient","to":"place:kaffa","mode":"sea","conf":"attested","start_date":"1332-08","end_date":"1332-09","note":"Genoese Kaffa in the Crimea"},{"from":"place:kaffa","to":"place:new_sarai","mode":"horse","conf":"estimated","start_date":"1332-09","end_date":"1332-10","note":"Golden Horde, camp of Ozbeg Khan"},{"from":"place:new_sarai","to":"place:constantinople","mode":"horse","conf":"approximate","start_date":"1332-10","end_date":"1332-11","note":"escorts the khatun Bayalun home; only Muslim account of the Byzantine city (dates disputed)"},{"from":"place:constantinople","to":"place:bukhara","mode":"caravan","conf":"estimated","start_date":"1332-12","end_date":"1333-03","note":"still half-ruined from the Mongol sack"},{"from":"place:bukhara","to":"place:samarkand","mode":"caravan","conf":"estimated","start_date":"1333-03","end_date":"1333-04"},{"from":"place:samarkand","to":"place:balkh","mode":"caravan","conf":"estimated","start_date":"1333-04","end_date":"1333-05"},{"from":"place:balkh","to":"place:herat","mode":"caravan","conf":"estimated","start_date":"1333-05","end_date":"1333-06"},{"from":"place:herat","to":"place:hyderabad_pakistan","mode":"horse","conf":"attested","start_date":"1333-06","end_date":"1333-09-12","note":"reaches the Indus; India begins"},{"from":"place:hyderabad_pakistan","to":"place:delhi","mode":"horse","conf":"attested","start_date":"1333-