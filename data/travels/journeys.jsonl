{"id":"route:journey:humboldt","kind":"route","subtype":"journey","name":"Humboldt and Bonpland in the Americas","carrier":"person:alexander_von_humboldt","lenses":["people","geography"],"start":1799,"end":1804,"what":"Five years of measuring everything from the Orinoco to the Andes; the voyage that founded modern geography (1799-1804).","legs":[{"from":"place:a_coruna","to":"place:santa_cruz_de_tenerife","mode":"sea","conf":"attested","start_date":"1799-06-05","end_date":"1799-06-19","note":"climbs the Teide"},{"from":"place:santa_cruz_de_tenerife","to":"place:cumana","mode":"sea","conf":"attested","start_date":"1799-06-25","end_date":"1799-07-16"},{"from":"place:cumana","to":"place:caracas","mode":"sea","conf":"attested","start_date":"1799-11-16","end_date":"1799-11-21"},{"from":"place:caracas","to":"place:casiquiare","mode":"river","conf":"attested","start_date":"1800-02-07","end_date":"1800-05-10","note":"proves the Orinoco and Amazon are joined"},{"from":"place:casiquiare","to":"place:ciudad_bolivar","mode":"river","conf":"attested","start_date":"1800-05-20","end_date":"1800-06-13"},{"from":"place:ciudad_bolivar","to":"place:havana","mode":"sea","conf":"attested","start_date":"1800-07-10","end_date":"1800-12-19"},{"from":"place:havana","to":"place:cartagena","mode":"sea","conf":"attested","start_date":"1801-03-09","end_date":"1801-03-30"},{"from":"place:cartagena","to":"place:bogota","mode":"river","conf":"attested","start_date":"1801-04-19","end_date":"1801-07-06","note":"with the botanist Mutis"},{"from":"place:bogota","to":"place:quito","mode":"horse","conf":"attested","start_date":"1801-09-08","end_date":"1802-01-06"},{"from":"place:quito","to":"place:chimborazo","mode":"foot","conf":"attested","start_date":"1802-06-09","end_date":"1802-06-23","note":"climbs to about 5,900 m, then a world record"},{"from":"place:chimborazo","to":"place:lima","mode":"horse","conf":"attested","start_date":"1802-06-23","end_date":"1802-10-23","note":"observes the transit of Mercury; the Humboldt Current"},{"from":"place:lima","to":"place:guayaquil","mode":"sea","conf":"attested","start_date":"1802-12-24","end_date":"1803-01-04"},{"from":"place:guayaquil","to":"place:acapulco","mode":"sea","conf":"attested","start_date":"1803-02-17","end_date":"1803-03-23"},{"from":"place:acapulco","to":"place:mexico_city","mode":"horse","conf":"attested","start_date":"1803-03-28","end_date":"1803-04-12"},{"from":"place:mexico_city","to":"place:veracruz","mode":"horse","conf":"attested","start_date":"1804-01-20","end_date":"1804-02-19"},{"from":"place:veracruz","to":"place:philadelphia","mode":"sea","conf":"attested","start_date":"1804-03-07","end_date":"1804-05-24"},{"from":"place:philadelphia","to":"place:washington","mode":"land","conf":"attested","start_date":"1804-05-29","end_date":"1804-06-01","note":"three weeks with President Jefferson"},{"from":"place:washington","to":"place:bordeaux","mode":"sea","conf":"attested","start_date":"1804-06-13","end_date":"1804-08-03","note":"home with 60,000 plant specimens"}],"sources":[{"cite":"Alexander von Humboldt and Aimé Bonpland, Personal Narrative of Travels to the Equinoctial Regions of America (1814-1829)"},{"cite":"Andrea Wulf, The Invention of Nature (Knopf, 2015)"}],"status":"draft","conf":"attested"}
