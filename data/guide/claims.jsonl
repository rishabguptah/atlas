{"id": "rel:crossing_of_the_rhine_406_contributed_to_fall_of_western_roman_empire_476_heather", "kind": "relation", "type": "contributed_to", "from": "event:crossing_of_the_rhine_406", "to": "event:fall_of_western_roman_empire_476", "confidence": 0.7, "view": "Peter Heather", "lenses": ["military", "population"], "sources": [{"src": "src:heather_2005_fall", "cite": "Heather 2005"}], "status": "sourced", "note": "Opened the West's heartland to groups it could not expel.", "mech": "Groups the West could neither destroy nor expel settled inside Gaul and Spain, shrinking the tax base that paid the Western army.", "conf": "approximate", "checked": {"on": "2026-10-25", "by": "scholarship upgrade", "note": "Heather's core thesis; contested by internal-decay readings (Goldsworthy) and by Halsall and Kulikowski on the date and nature of the crossing."}}
{"id": "rel:vandals_take_carthage_439_contributed_to_fall_of_western_roman_empire_476_heather", "kind": "relation", "type": "contributed_to", "from": "event:vandals_take_carthage_439", "to": "event:fall_of_western_roman_empire_476", "confidence": 0.8, "view": "Peter Heather", "lenses": ["economy"], "sources": [{"src": "src:heather_2005_fall", "cite": "Heather 2005"}, {"src": "src:wickham_2005_framing", "cite": "Wickham 2005"}], "status": "sourced", "note": "Cost the West its richest tax and grain province.", "mech": "Losing Africa cut the Western state's richest source of tax and of Rome's grain, so it could no longer pay enough soldiers to hold its other provinces.", "conf": "estimated", "checked": {"on": "2026-10-25", "by": "scholarship upgrade", "note": "Heather and Wickham both treat 439 as the decisive fiscal blow; widely accepted."}}
{"id": "rel:battle_of_cap_bon_468_contributed_to_fall_of_western_roman_empire_476_heather", "kind": "relation", "type": "contributed_to", "from": "event:battle_of_cap_bon_468", "to": "event:fall_of_western_roman_empire_476", "confidence": 0.45, "view": "Peter Heather", "lenses": ["military", "economy"], "sources": [{"src": "src:heather_2005_fall", "cite": "Heather 2005"}], "status": "sourced", "note": "Ended the last chance to recover Africa.", "mech": "The failure of the joint East-West armada wasted the resources that might have won back Africa, leaving the West with no fiscal base to recover from.", "conf": "approximate", "checked": {"on": "2026-10-25", "by": "scholarship upgrade", "note": "Heather treats 468 as the West's last chance; the counterfactual is argued, not measured."}}
{"id": "rel:attila_invades_gaul_451_contributed_to_fall_of_western_roman_empire_476_kelly", "kind": "relation", "type": "contributed_to", "from": "event:attila_invades_gaul_451", "to": "event:fall_of_western_roman_empire_476", "confidence": 0.4, "view": "Christopher Kelly", "lenses": ["military"], "sources": [{"src": "src:kelly_2009_end", "cite": "Kelly 2009 (UK ed. 2008)"}], "status": "sourced", "note": "Hun pressure turned west after the Balkans were stripped and Marcian stopped paying tribute in 450.", "mech": "Attila's campaigns in Gaul (451) and Italy (452) drained Western armies and, with Aetius' murder in 454, left the West without the general who had held it together.", "conf": "approximate", "checked": {"on": "2026-10-25", "by": "scholarship upgrade", "note": "Corrected the note: Attila turned west after Marcian stopped the tribute in 450, not because the East paid. Heather instead stresses the Hun empire's collapse after 453 as the bigger shock, so confidence lowered."}}
{"id": "rel:theodosian_walls_413_prevented_fall_of_constantinople_1453", "kind": "relation", "type": "prevented", "from": "event:theodosian_walls_413", "to": "event:fall_of_constantinople_1453", "confidence": 0.7, "lenses": ["geography", "military"], "sources": [{"cite": "Wikipedia, Walls of Constantinople", "url": "https://en.wikipedia.org/wiki/Walls_of_Constantinople"}, {"src": "src:turnbull_2004_walls", "cite": "Turnbull 2004"}, {"src": "src:crowley_2005_constantinople", "cite": "Crowley 2005"}], "status": "sourced", "note": "The land walls held against every attacker until 1453 (1204 came over the sea walls). 'Prevented' here means delayed for about a thousand years.", "mech": "The triple land wall, with sea on the other sides, turned every land assault into a siege the attacker could not win until gunpowder artillery.", "conf": "estimated", "checked": {"on": "2026-10-25", "by": "scholarship upgrade", "note": "No assault broke the land walls before 1453; 1204 came over the Golden Horn sea walls and 1261 through a gate by surprise. 'Prevented' means delayed."}}
{"id": "rel:plague_of_justinian_541_contributed_to_byzantine_harper", "kind": "relation", "type": "contributed_to", "from": "event:plague_of_justinian_541", "to": "polity:byzantine", "confidence": 0.5, "view": "Kyle Harper", "lenses": ["disease", "population"], "sources": [{"src": "src:harper_2017_fate", "cite": "Harper 2017"}, {"src": "src:mordechai_2019_justinianic", "cite": "Mordechai et al. 2019"}], "status": "sourced", "note": "Weakened the East a century after the West fell; explains shrinkage, not survival.", "mech": "Repeated plague waves from 541 cut the East's taxpayers and recruits, weakening it before the Persian and Arab wars of the 7th century.", "conf": "approximate", "checked": {"on": "2026-10-25", "by": "scholarship upgrade", "note": "Harper argues for heavy mortality; Mordechai, Eisenberg et al. (2019) argue the pandemic's effects have been overstated, so confidence lowered."}}
