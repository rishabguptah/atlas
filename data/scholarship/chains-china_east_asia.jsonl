{"id": "chain:china_east_asia_frontier_to_market", "kind": "chain", "name": "From frontier armies to a market economy", "blurb": "Xuanzong's wars built huge frontier armies; one general turned them on the court; the census collapsed; the state gave up allotting land and taxed property instead, opening the road to the Song boom.", "links": ["rel:why:china_east_asia:tianbao_wars_build_armies", "rel:why:china_east_asia:jiedushi_enable_rebellion", "rel:why:china_east_asia:an_lushan_census_collapse", "rel:why:china_east_asia:census_collapse_liangshui", "rel:why:china_east_asia:liangshui_commercialises"], "debates": ["debate:china_east_asia_an_lushan", "debate:china_east_asia_song_revolution"], "question": "When did Western Europe actually start to become richer than China? (where China's Song peak came from)", "lenses": ["military", "order", "population", "law", "economy"], "start": 742, "end": 1127, "sources": [{"src": "src:pulleyblank_1955_background", "cite": "Pulleyblank 1955"}, {"src": "src:graff_2002_medieval", "cite": "Graff 2002"}, {"src": "src:durand_1960_population", "cite": "Durand 1960"}, {"src": "src:twitchett_1979_cambridge", "cite": "Twitchett 1979"}, {"src": "src:vonglahn_2016_economic", "cite": "von Glahn 2016"}], "status": "sourced"}
{"id": "chain:china_east_asia_salt_to_exam_state", "kind": "chain", "name": "From salt smugglers to the examination state", "blurb": "After An Lushan the court lived on a salt monopoly; salt smugglers became Huang Chao's armies; they wiped out the great clans; the Song filled office by examination, with an elite too scattered to defy the throne.", "links": ["rel:why:china_east_asia:an_lushan_census_collapse", "rel:why:china_east_asia:census_collapse_salt_monopoly", "rel:why:china_east_asia:salt_monopoly_huang_chao", "rel:why:china_east_asia:huang_chao_aristocracy", "rel:why:china_east_asia:aristocracy_end_central_state"], "debates": ["debate:china_east_asia_an_lushan", "debate:china_east_asia_why_china_unified"], "question": "Why did China consolidate?", "lenses": ["military", "population", "economy", "order", "people"], "start": 755, "end": 1279, "sources": [{"src": "src:durand_1960_population", "cite": "Durand 1960"}, {"src": "src:twitchett_1979_cambridge", "cite": "Twitchett 1979"}, {"src": "src:lewis_2009_cosmopolitan", "cite": "Lewis 2009"}, {"src": "src:tackett_2014_destruction", "cite": "Tackett 2014"}, {"src": "src:wang_2022_rise", "cite": "Wang 2022"}], "status": "sourced"}
{"id": "chain:china_east_asia_drought_to_reunification", "kind": "chain", "name": "From a Mongolian drought to a reunified China", "blurb": "Hard years in the 1180s broke the old tribes; Temujin rebuilt them into one army; a steppe state had to conquer to survive; it ended three centuries of Chinese division.", "links": ["rel:why:china_east_asia:drought_1180s_unification", "rel:why:china_east_asia:supratribal_needs_plunder", "rel:why:china_east_asia:expansion_reunifies_china"], "debates": ["debate:china_east_asia_mongol_rise", "debate:china_east_asia_why_china_unified"], "question": "Why did China consolidate?", "lenses": ["geography", "order", "military"], "start": 1180, "end": 1279, "sources": [{"src": "src:pederson_2014_pluvials", "cite": "Pederson et al. 2014"}, {"src": "src:fletcher_1986_mongols", "cite": "Fletcher 1986"}, {"src": "src:khazanov_1984_nomads", "cite": "Khazanov 1984"}, {"src": "src:scheidel_2019_escape", "cite": "Scheidel 2019"}, {"src": "src:mote_1999_imperial", "cite": "Mote 1999"}], "status": "sourced"}
{"id": "chain:china_east_asia_rain_to_london_wages", "kind": "chain", "name": "From a wet decade in Mongolia to London's wages", "blurb": "The Mongol pluvial fed the horses of conquest; the Mongol world carried plague west; the Black Death made labour scarce; North Sea wages stayed high; dear labour made British machines pay.", "links": ["rel:why:china_east_asia:pluvial_fuels_expansion", "rel:why:china_east_asia:expansion_pax_mongolica", "rel:why:china_east_asia:pax_mongolica_plague", "rel:why:china_east_asia:second_pandemic_black_death", "rel:why:china_east_asia:black_death_high_wages", "rel:why:china_east_asia:high_wages_industrial_revolution", "rel:why:china_east_asia:ir_divergence"], "debates": ["debate:china_east_asia_mongol_rise", "debate:china_east_asia_when_west_richer"], "question": "When did Western Europe actually start to become richer than China?", "lenses": ["geography", "military", "economy", "disease"], "start": 1211, "end": 1900, "sources": [{"src": "src:pederson_2014_pluvials", "cite": "Pederson et al. 2014"}, {"src": "src:putnam_2016_little", "cite": "Putnam 2016"}, {"src": "src:allsen_2001_culture", "cite": "Allsen 2001"}, {"src": "src:abulughod_1989_before", "cite": "Abu-Lughod 1989"}, {"src": "src:spyrou_2022_source", "cite": "Spyrou 2022"}, {"src": "src:mcneill_1976_plagues", "cite": "McNeill 1976"}, {"src": "src:allen_2009_british", "cite": "Allen 2009"}, {"src": "src:broadberry_2015_british", "cite": "Broadberry et al. 2015"}, {"src": "src:pomeranz_2000_great", "cite": "Pomeranz 2000"}], "status": "sourced"}
{"id": "chain:china_east_asia_silver_to_conquest", "kind": "chain", "name": "Silver, war and the fall of the Ming", "blurb": "Potosí silver met Chinese demand at Manila; the Single Whip tied the treasury to silver; the rigid system could only pay for the Manchu war with surtaxes; the surtaxes made rebels; the rebels took Beijing; the Manchus rebuilt the empire.", "links": ["rel:why:china_east_asia:potosi_manila", "rel:why:china_east_asia:manila_silver_single_whip", "rel:why:china_east_asia:fiscal_weakness_huang", "rel:why:china_east_asia:war_surtax_rebellions", "rel:why:china_east_asia:rebellions_end_ming", "rel:why:china_east_asia:end_ming_qing_conquest", "rel:why:china_east_asia:qing_conquest_reunifies"], "debates": ["debate:china_east_asia_ming_collapse", "debate:china_east_asia_why_china_unified"], "question": "Why did China consolidate?", "lenses": ["geography", "economy", "law", "military", "order"], "start": 1545, "end": 1683, "sources": [{"src": "src:flynn_2002_cycles", "cite": "Flynn and Giráldez 2002"}, {"src": "src:atwell_1982_international", "cite": "Atwell 1982"}, {"src": "src:huang_1974_taxation", "cite": "Huang 1974"}, {"src": "src:huang_1981_1587", "cite": "Huang 1981"}, {"src": "src:swope_2014_military", "cite": "Swope 2014"}, {"src": "src:wakeman_1985_great", "cite": "Wakeman 1985"}], "status": "sourced"}
{"id": "chain:china_east_asia_volcano_to_beijing", "kind": "chain", "name": "From a Japanese volcano to the fall of Beijing", "blurb": "Eruptions in 1640-41 deepened the coldest decade in China's record; the monsoon failed; famine bred epidemics; disease emptied Beijing's garrison before Li Zicheng arrived.", "links": ["rel:why:china_east_asia:komagatake_cold", "rel:why:china_east_asia:cold_drought_famine", "rel:why:china_east_asia:drought_epidemics", "rel:why:china_east_asia:epidemics_fall_beijing", "rel:why:china_east_asia:ming_crisis_general"], "debates": ["debate:china_east_asia_ming_collapse", "debate:china_east_asia_steppe_climate"], "question": "Why did China consolidate? (and why it kept falling apart before reuniting)", "lenses": ["geography", "disease", "order"], "start": 1630, "end": 1660, "sources": [{"src": "src:atwell_2001_volcanism", "cite": "Atwell 2001"}, {"src": "src:parker_2013_global", "cite": "Parker 2013"}, {"src": "src:zheng_2014_how", "cite": "Zheng et al. 2014"}, {"src": "src:brook_2010_troubled", "cite": "Brook 2010"}], "status": "sourced"}
{"id": "chain:china_east_asia_opium_to_warlords", "kind": "chain", "name": "From the Canton trade to the warlord provinces", "blurb": "Opium through Canton drained silver; the drain brought war with Britain; defeat unsettled the south; the Taiping war forced the court to let Zeng Guofan raise his own army; the provinces kept their armies until they let the dynasty fall.", "links": ["rel:why:china_east_asia:canton_system_opium", "rel:why:china_east_asia:silver_outflow_opium_war", "rel:why:china_east_asia:opium_war_disorder", "rel:why:china_east_asia:taiping_xiang_army", "rel:why:china_east_asia:taiping_provincial_power", "rel:why:china_east_asia:provincial_power_end_qing"], "debates": ["debate:china_east_asia_taiping"], "question": "Why did China consolidate? (how the last empire came apart)", "lenses": ["law", "economy", "military", "order"], "start": 1757, "end": 1911, "sources": [{"src": "src:lovell_2011_opium", "cite": "Lovell 2011"}, {"src": "src:lin_2006_china", "cite": "Lin 2006"}, {"src": "src:wakeman_1966_strangers", "cite": "Wakeman 1966"}, {"src": "src:kuhn_1970_rebellion", "cite": "Kuhn 1970"}, {"src": "src:kuhn_2002_origins", "cite": "Kuhn 2002"}], "status": "sourced"}
{"id": "chain:china_east_asia_exam_failure_to_divergence", "kind": "chain", "name": "From a failed exam to a gutted delta", "blurb": "Hong Xiuquan failed the exams and saw visions; his God Worshippers became the Taiping; the war emptied the Yangzi delta, China's richest region, just as Britain pulled away.", "links": ["rel:why:china_east_asia:exams_hong_vision", "rel:why:china_east_asia:hong_vision_taiping", "rel:why:china_east_asia:taiping_delta_depopulation", "rel:why:china_east_asia:delta_depop_divergence"], "debates": ["debate:china_east_asia_taiping", "debate:china_east_asia_when_west_richer"], "question": "When did Western Europe actually start to become richer than China?", "lenses": ["law", "religion", "order", "military", "population", "economy"], "start": 1827, "end": 1900, "sources": [{"src": "src:spence_1996_gods", "cite": "Spence 1996"}, {"src": "src:jen_1973_taiping", "cite": "Jen 1973"}, {"src": "src:meyerfong_2013_what", "cite": "Meyer-Fong 2013"}, {"src": "src:platt_2012_autumn", "cite": "Platt 2012"}], "status": "sourced"}
{"id": "chain:china_east_asia_black_ships_to_battleships", "kind": "chain", "name": "From the Black Ships to the battle of the Yalu", "blurb": "Perry's squadron discredited the shogun; the shogunate fell to Satsuma and Choshu; the new state built railways; rail-linked markets bred factories; industry armed the forces that beat China in 1894-95.", "links": ["rel:why:china_east_asia:perry_bakufu_legitimacy", "rel:why:china_east_asia:bakufu_crisis_restoration", "rel:why:china_east_asia:restoration_railways", "rel:why:china_east_asia:railways_industry", "rel:why:china_east_asia:meiji_industry_war"], "debates": ["debate:china_east_asia_meiji"], "question": "When did Western Europe actually start to become richer than China? (and why Japan, not China, caught up first)", "lenses": ["military", "order", "economy"], "start": 1853, "end": 1913, "sources": [{"src": "src:beasley_1972_meiji", "cite": "Beasley 1972"}, {"src": "src:satow_1921_diplomat", "cite": "Satow 1921"}, {"src": "src:tang_2014_railroad", "cite": "Tang 2014"}, {"src": "src:jansen_2000_making", "cite": "Jansen 2000"}], "status": "sourced"}
{"id": "chain:china_east_asia_steppe_to_light_state", "kind": "chain", "name": "From the steppe frontier to a state too light to modernise", "blurb": "Steppe pressure rewarded one big centralised empire; an empire without rivals could tax lightly; the 1712 tax freeze left the Qing poor in revenue while Britain's warring state built a navy and a fiscal machine.", "links": ["rel:why:china_east_asia:steppe_threat_unifies_china", "rel:why:china_east_asia:unity_low_tax_rosenthal", "rel:why:china_east_asia:tax_freeze_divergence_vries"], "debates": ["debate:china_east_asia_why_china_unified", "debate:china_east_asia_when_west_richer"], "question": "Why did China consolidate? / When did Western Europe actually start to become richer than China?", "lenses": ["military", "order", "economy", "law"], "start": 589, "end": 1850, "sources": [{"src": "src:ko_2018_unified", "cite": "Ko et al. 2018"}, {"src": "src:rosenthal_2011_before", "cite": "Rosenthal and Wong 2011"}, {"src": "src:vries_2015_state", "cite": "Vries 2015"}], "status": "sourced"}
{"id": "chain:china_east_asia_mountains_to_machines", "kind": "chain", "name": "From the Alps to the steam engine", "blurb": "Mountains and seas kept Europe divided; division meant thinkers could flee and publish elsewhere; competing ideas produced the scientific revolution; science joined craft in the industrial revolution; the divergence followed.", "links": ["rel:why:china_east_asia:mountains_fragment_europe", "rel:why:china_east_asia:polycentrism_market_for_ideas", "rel:why:china_east_asia:market_for_ideas_scirev", "rel:why:china_east_asia:scirev_divergence", "rel:why:china_east_asia:ir_divergence"], "debates": ["debate:china_east_asia_why_china_unified", "debate:china_east_asia_needham_question", "debate:china_east_asia_when_west_richer"], "question": "Why did China consolidate? / When did Western Europe actually start to become richer than China?", "lenses": ["geography", "order", "ideas", "economy"], "start": 600, "end": 1900, "sources": [{"src": "src:fernandezvillaverde_2023_fractured", "cite": "Fernández-Villaverde et al. 2023"}, {"src": "src:diamond_1997_guns", "cite": "Diamond 1997"}, {"src": "src:mokyr_2016_culture", "cite": "Mokyr 2016"}, {"src": "src:pomeranz_2000_great", "cite": "Pomeranz 2000"}, {"src": "src:broadberry_2015_british", "cite": "Broadberry et al. 2015"}], "status": "sourced"}
{"id": "chain:china_east_asia_peace_to_trap", "kind": "chain", "name": "From the Qing peace to the Needham question", "blurb": "Conquest brought a century of peace; population nearly tripled; cheap labour deepened Elvin's high-level equilibrium trap; machines did not pay and science did not take off; the gap with Europe widened.", "links": ["rel:why:china_east_asia:qing_peace_population", "rel:why:china_east_asia:population_hlet", "rel:why:china_east_asia:hlet_needham_elvin", "rel:why:china_east_asia:needham_outcome_divergence"], "debates": ["debate:china_east_asia_needham_question", "debate:china_east_asia_when_west_richer"], "question": "When did Western Europe actually start to become richer than China?", "lenses": ["order", "population", "economy", "ideas"], "start": 1400, "end": 1900, "sources": [{"src": "src:ho_1959_studies", "cite": "Ho 1959"}, {"src": "src:elvin_1973_pattern", "cite": "Elvin 1973"}, {"src": "src:landes_1998_wealth", "cite": "Landes 1998"}], "status": "sourced"}
