{"id": "event:europe_medieval_early_modern_seigneurial_revenue_crisis", "kind": "event", "subtype": "collapse", "name": "Crisis of seigneurial revenues", "start": 1315, "end": 1450, "lat": 49.4, "lon": 1.1, "lenses": ["economy", "order"], "what": "Lords' incomes from rents and dues fell as tenants died or left, grain prices sagged and arrears mounted.", "start_approx": true, "end_approx": true, "conf": "approximate", "sources": [{"src": "src:bois_1984_crisis", "cite": "Bois 1984"}], "status": "sourced"}
