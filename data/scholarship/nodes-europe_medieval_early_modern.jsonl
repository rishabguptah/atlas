{"id": "event:europe_medieval_early_modern_mediterranean_contraction", "kind": "event", "subtype": "exchange", "name": "Contraction of Mediterranean long-distance trade", "start": 600, "end": 750, "lat": 38.0, "lon": 15.0, "lenses": ["economy", "geography"], "what": "Bulk exchange between the eastern and western Mediterranean shrank to a trickle between the late 6th and mid-8th centuries.", "start_approx": true, "end_approx": true, "conf": "approximate", "sources": [{"src": "src:pirenne_1939_mohammed", "cite": "Pirenne 1939"}, {"src": "src:wickham_2005_framing", "cite": "Wickham 2005"}], "status": "sourced"}
{"id": "event:europe_medieval_early_modern_abbasid_silver_north", "kind": "event", "subtype": "exchange", "name": "Islamic silver flows to the Baltic", "start": 780, "end": 1000, "lat": 57.5, "lon": 18.5, "lenses": ["economy", "geography"], "what": "Hundreds of thousands of Abbasid and Samanid silver dirhams reached Scandinavia and the Baltic along the Russian rivers.", "start_approx": true, "end_approx": true, "conf": "approximate", "sources": [{"src": "src:hodges_1983_mohammed", "cite": "Hodges & Whitehouse 1983"}], "status": "sourced"}
{"id": "event:europe_medieval_early_modern_carolingian_revival", "kind": "event", "subtype": "exchange", "name": "Carolingian commercial revival", "start": 775, "end": 900, "lat": 45.44, "lon": 12.33, "lenses": ["economy", "people"], "what": "Shipping, markets and coin use in the Frankish world and Venice picked up after c.775, partly on the back of selling captives to the caliphate.", "start_approx": true, "end_approx": true, "conf": "approximate", "sources": [{"src": "src:mccormick_2001_origins", "cite": "McCormick 2001"}], "status": "sourced"}
