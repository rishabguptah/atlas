{"id": "event:europe_medieval_early_modern_urban_communes", "kind": "event", "subtype": "founding", "name": "Rise of self-governing towns", "start": 1080, "end": 1250, "lat": 45.46, "lon": 9.19, "lenses": ["order", "law", "economy"], "what": "Towns in Italy, Flanders and the Rhineland won charters and sworn communes that let burghers govern themselves.", "start_approx": true, "end_approx": true, "conf": "approximate", "sources": [{"src": "src:pirenne_1925_medieval", "cite": "Pirenne 1925"}, {"src": "src:stasavage_2020_decline", "cite": "Stasavage 2020"}], "status": "sourced"}
{"id": "event:europe_medieval_early_modern_venice_serrata", "kind": "event", "subtype": "law", "name": "Closing of Venice's Great Council (Serrata)", "start": 1297, "end": 1323, "lat": 45.434, "lon": 12.339, "lenses": ["law", "order"], "what": "From 1297 membership of the Great Council was restricted to established families, closing Venice's political elite.", "conf": "attested", "sources": [{"src": "src:puga_2014_international", "cite": "Puga & Trefler 2014"}], "status": "sourced"}
{"id": "event:europe_medieval_early_modern_population_peak_1300", "kind": "event", "subtype": "famine", "name": "Population peak and land hunger", "start": 1250, "end": 1315, "lat": 50.0, "lon": 3.0, "lenses": ["population", "economy"], "what": "By c.1300 Europe held perhaps twice its population of 1000, with holdings subdivided and poor soils under the plough.", "start_approx": true, "end_approx": true, "conf": "approximate", "sources": [{"src": "src:postan_1972_medieval", "cite": "Postan 1972"}, {"src": "src:campbell_2016_great", "cite": "Campbell 2016"}], "status": "sourced"}
{"id": "event:europe_medieval_early_modern_bovine_panzootic", "kind": "event", "subtype": "epidemic", "name": "Great Bovine Pestilence", "start": 1315, "end": 1325, "lat": 52.5, "lon": -1.5, "lenses": ["disease", "economy"], "what": "A cattle plague, probably rinderpest, swept from central Europe to England (1319-20) and Ireland, killing most draught oxen and milk cows where it struck.", "start_approx": true, "end_approx": true, "conf": "approximate", "sources": [{"src": "src:campbell_2016_great", "cite": "Campbell 2016"}], "status": "sourced"}
{"id": "event:europe_medieval_early_modern_pastoureaux_1320", "kind": "event", "subtype": "revolt", "name": "Shepherds' Crusade of 1320", "start": 1320, "end": 1320, "lat": 43.6, "lon": 1.44, "lenses": ["religion", "order"], "what": "Bands of young rural poor marched south through France, attacking royal officials and massacring Jewish communities from Toulouse to Aragon.", "conf": "attested", "sources": [{"src": "src:nirenberg_1996_communities", "cite": "Nirenberg 1996"}], "status": "sourced"}
