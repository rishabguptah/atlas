{"id": "m:lead_emissions:europe:mcconnell_2018", "kind": "measure", "of": "place:region_europe", "metric": "lead_emissions", "unit": "kt_per_year", "what": "Roman-era European lead emissions at the first-century peak.", "points": [[50, 1.1, 0.55, 2.2]], "method": "NGRIP2 ice-core lead deposition converted to European emissions with FLEXPART transport modelling (single source in southern Spain). First-century average; the band is the authors' factor-of-two uncertainty in the conversion. Annual values in the century ranged from 0.3 to 3.8 kt.", "src": "src:mcconnell_2018_lead", "lenses": ["economy", "geography"], "sources": [{"src": "src:mcconnell_2018_lead", "cite": "McConnell et al. 2018"}], "status": "sourced", "note": "The full annual series (1100 BCE-800 CE) is in the paper's supplement; only the figures stated in the text are entered here. Emissions fall abruptly in 165 CE and stay low until about 750."}
{"id": "m:lead_concentration:greenland:mcconnell_2018", "kind": "measure", "of": "place:greenland", "metric": "lead_concentration", "unit": "pg_per_g", "what": "Lead in Greenland ice, before and during Rome.", "points": [[-1050, 1.4], [50, 3.0]], "method": "Average lead concentration measured in the NGRIP2 core: background (1100-1000 BCE) and Roman period.", "src": "src:mcconnell_2018_lead", "lenses": ["geography", "economy"], "sources": [{"src": "src:mcconnell_2018_lead", "cite": "McConnell et al. 2018"}], "status": "sourced"}
{"id": "m:population:region_rapa_nui:davis_2024", "kind": "measure", "of": "place:region_rapa_nui", "metric": "population", "unit": "people", "what": "How many people Rapa Nui could feed, from its rock gardens.", "points": [[1722, 3000, 2000, 4000]], "method": "Carrying capacity from satellite-mapped rock gardens: about 2,000 people on sweet potato alone, about 3,000 adding marine and other food; gardens could not have supported more than about 4,000.", "src": "src:davis_2024_island", "lenses": ["population", "economy"], "sources": [{"src": "src:davis_2024_island", "cite": "Davis et al. 2024"}], "status": "sourced"}
