{"id": "chain:order_chaos_plague_to_freedom", "kind": "chain", "name": "One plague, two Europes", "blurb": "The Black Death made labour scarce everywhere; English peasants turned that into freedom, while lords east of the Elbe turned it into a second serfdom.", "start": 1348, "end": 1650, "links": ["rel:why:order_chaos:black_death_rising_1381_brenner", "rel:why:order_chaos:rising_1381_serfdom_decline", "rel:why:order_chaos:black_death_serfdom_decline_postan", "rel:why:order_chaos:black_death_second_serfdom_brenner"], "debates": ["debate:order_chaos_secular_cycles", "debate:order_chaos_why_nations_fail"], "question": "Why does order happen vs chaos?", "lenses": ["disease", "order", "law"], "sources": [{"src": "src:brenner_1976_agrarian", "cite": "Brenner 1976"}, {"src": "src:acemoglu_2012_why", "cite": "Acemoglu & Robinson 2012"}], "status": "sourced"}
{"id": "chain:order_chaos_cycle_to_leviathan", "kind": "chain", "name": "From a crowded England to Leviathan", "blurb": "A doubled population and a broke crown led to civil war, and civil war led Hobbes to argue that any sovereign beats anarchy.", "start": 1500, "end": 1651, "links": ["rel:why:order_chaos:tudor_stuart_cycle_civil_war_goldstone", "rel:why:order_chaos:stuart_kingdoms_civil_war_russell"], "debates": ["debate:order_chaos_secular_cycles", "debate:order_chaos_violence_order"], "question": "Why does order happen vs chaos?", "lenses": ["population", "order", "ideas"], "sources": [{"src": "src:goldstone_1991_revolution", "cite": "Goldstone 1991"}, {"src": "src:hobbes_1651_leviathan", "cite": "Hobbes 1651"}], "status": "sourced"}
{"id": "chain:order_chaos_drought_to_beijing", "kind": "chain", "name": "Drought, debt and the fall of the Ming", "blurb": "Drought and an empty treasury turned soldiers and peasants into Li Zicheng's army, which took Beijing in 1644.", "start": 1620, "end": 1644, "links": ["rel:why:order_chaos:late_ming_drought_li_zicheng", "rel:why:order_chaos:li_zicheng_end_ming", "rel:why:order_chaos:ming_fiscal_li_zicheng_goldstone", "rel:why:order_chaos:silver_slump_ming_fiscal_atwell"], "debates": ["debate:order_chaos_secular_cycles"], "question": "What does the end of a world look like?", "lenses": ["geography", "economy", "order"], "sources": [{"src": "src:parker_2013_global", "cite": "Parker 2013"}, {"src": "src:goldstone_1991_revolution", "cite": "Goldstone 1991"}], "status": "sourced"}
{"id": "chain:order_chaos_end_of_bronze_age", "kind": "chain", "name": "The end of the Bronze Age world", "blurb": "Drought set people moving, raiders burned Ugarit, trade broke, and the palace kingdoms fell; Phoenicians, iron and the alphabet filled the gap.", "start": -1250, "end": -1000, "links": ["rel:why:order_chaos:lba_drought_sea_peoples", "rel:why:order_chaos:sea_peoples_ugarit", "rel:why:order_chaos:ugarit_systems_collapse", "rel:why:order_chaos:lba_end_mycenaean", "rel:why:order_chaos:lba_phoenicia", "rel:why:order_chaos:phoenicia_alphabet"], "debates": ["debate:order_chaos_bronze_age_end"], "question": "What does the end of a world look like?", "lenses": ["geography", "military", "economy", "ideas"], "sources": [{"src": "src:cline_2014_1177", "cite": "Cline 2014"}, {"src": "src:cline_2024_after", "cite": "Cline 2024"}], "status": "sourced"}
{"id": "chain:order_chaos_rapa_nui", "kind": "chain", "name": "Rapa Nui: rats, rock gardens and slavers", "blurb": "Rats ate the forest's future, islanders adapted with stone-mulch gardens, and the real collapse came with ships.", "start": 1200, "end": 1877, "links": ["rel:why:order_chaos:rapa_nui_settlement_deforestation_rats", "rel:why:order_chaos:rapa_nui_deforestation_gardens", "rel:why:order_chaos:rapa_nui_contact_raids", "rel:why:order_chaos:rapa_nui_raids_nadir"], "debates": ["debate:order_chaos_rapa_nui"], "question": "What does the end of a world look like?", "lenses": ["population", "geography", "economy", "order"], "sources": [{"src": "src:hunt_2011_statues", "cite": "Hunt & Lipo 2011"}, {"src": "src:davis_2024_island", "cite": "Davis et al. 2024"}], "status": "sourced"}
{"id": "chain:order_chaos_plague_silver_rome", "kind": "chain", "name": "Plague, silver and the price of empire", "blurb": "The Antonine Plague shut the silver mines, the coinage was debased, and Diocletian rebuilt the empire on a heavier tax state.", "start": 165, "end": 476, "links": ["rel:why:order_chaos:antonine_plague_silver_slump", "rel:why:order_chaos:silver_slump_debasement", "rel:why:order_chaos:debasement_diocletian", "rel:why:order_chaos:diocletian_fall_tainter"], "debates": ["debate:order_chaos_what_broke_rome", "debate:order_chaos_why_collapse"], "question": "What does the end of a world look like?", "lenses": ["disease", "economy", "law", "order"], "sources": [{"src": "src:mcconnell_2018_lead", "cite": "McConnell et al. 2018"}, {"src": "src:tainter_1988_collapse", "cite": "Tainter 1988"}], "status": "sourced"}
{"id": "chain:order_chaos_huns_to_476", "kind": "chain", "name": "From the steppe to the end of the West", "blurb": "The Huns pushed the Goths over the Danube, the Goths won at Adrianople and sacked Rome, and the West ran out of taxes and soldiers.", "start": 376, "end": 650, "links": ["rel:why:order_chaos:huns_adrianople", "rel:why:order_chaos:adrianople_sack_410", "rel:why:order_chaos:sack_410_fall_476", "rel:why:order_chaos:fall_476_simplification_wardperkins"], "debates": ["debate:order_chaos_what_broke_rome"], "question": "What does the end of a world look like?", "lenses": ["military", "order", "economy"], "sources": [{"src": "src:heather_2005_fall", "cite": "Heather 2005"}, {"src": "src:wardperkins_2005_fall", "cite": "Ward-Perkins 2005"}], "status": "sourced"}
{"id": "chain:order_chaos_dark_sun_536", "kind": "chain", "name": "The year the sun went dim", "blurb": "Volcanic cold from 536 and plague from 541 weakened Rome and Persia before the Arab conquests.", "start": 536, "end": 651, "links": ["rel:why:order_chaos:late_antique_lia_justinian_plague", "rel:why:order_chaos:justinian_plague_sasanian_harper", "rel:why:order_chaos:late_antique_lia_sasanian"], "debates": ["debate:order_chaos_what_broke_rome"], "question": "What does the end of a world look like?", "lenses": ["geography", "disease", "order"], "sources": [{"src": "src:harper_2017_fate", "cite": "Harper 2017"}, {"src": "src:buntgen_2016_cooling", "cite": "Büntgen et al. 2016"}], "status": "sourced"}
{"id": "chain:order_chaos_silver_to_poverty", "kind": "chain", "name": "Silver mountain, poor villages", "blurb": "The Potosí silver boom created a forced-labour system whose districts are still poorer two centuries after it ended.", "start": 1545, "end": 2001, "links": ["rel:why:order_chaos:potosi_silver_mita", "rel:why:order_chaos:mita_legacy_dell"], "debates": ["debate:order_chaos_why_nations_fail"], "question": "Why does order happen vs chaos?", "lenses": ["economy", "law"], "sources": [{"src": "src:dell_2010_mita", "cite": "Dell 2010"}], "status": "sourced"}
{"id": "chain:order_chaos_wars_to_compression", "kind": "chain", "name": "How total war flattened incomes", "blurb": "Two world wars and the policies they forced compressed incomes in the West more than anything in the previous century.", "start": 1914, "end": 1970, "links": ["rel:why:order_chaos:wwi_compression_piketty", "rel:why:order_chaos:wwii_compression_goldin", "rel:why:order_chaos:new_deal_compression_lindert"], "debates": ["debate:order_chaos_great_leveler"], "question": "Why does order happen vs chaos?", "lenses": ["military", "law", "economy"], "sources": [{"src": "src:scheidel_2017_great", "cite": "Scheidel 2017"}, {"src": "src:goldin_1992_great", "cite": "Goldin & Margo 1992"}], "status": "sourced"}
{"id": "chain:order_chaos_faith_to_empire", "kind": "chain", "name": "Faith, cohesion and conquest", "blurb": "Ibn Khaldun's test case: a new religion fused Arab tribes, which won at Qadisiyya and ended the Sasanian empire.", "start": 632, "end": 651, "links": ["rel:why:order_chaos:islam_qadisiyyah", "rel:why:order_chaos:qadisiyyah_end_sasanian"], "debates": ["debate:order_chaos_asabiyya", "debate:order_chaos_seshat_gods"], "question": "Why does order happen vs chaos?", "lenses": ["religion", "military", "order"], "sources": [{"src": "src:ibnkhaldun_1958_muqaddimah", "cite": "Ibn Khaldun, Muqaddimah, tr. Rosenthal"}], "status": "sourced"}
{"id": "chain:order_chaos_drought_42ka", "kind": "chain", "name": "The 4.2 ka drought", "blurb": "A centuries-long dry spell coincides with the end of Akkad, the Old Kingdom of Egypt and the Indus cities.", "start": -2200, "end": -1700, "links": ["rel:why:order_chaos:ka42_akkad", "rel:why:order_chaos:ka42_old_kingdom", "rel:why:order_chaos:ka42_indus"], "debates": ["debate:order_chaos_why_collapse"], "question": "What does the end of a world look like?", "lenses": ["geography", "order"], "sources": [{"src": "src:weiss_1993_genesis", "cite": "Weiss et al. 1993"}, {"src": "src:giosan_2012_fluvial", "cite": "Giosan et al. 2012"}], "status": "sourced"}
