{"id": "chain:modern_plague_to_prosperity", "kind": "chain", "name": "From plague to prosperity", "blurb": "The Black Death halved England's people; the survivors kept higher incomes, built a high-wage economy, mechanised, and in the nineteenth century left Asia far behind.", "start": 1348, "end": 1913, "links": ["rel:why:modern:plague_divergence_broadberry", "rel:why:modern:divergence_wages_allen", "rel:why:modern:wages_cotton_allen", "rel:why:modern:cotton_ir_crafts", "rel:why:modern:ir_divergence_maddison"], "debates": ["debate:when_western_europe_rich", "debate:why_industrial_revolution_britain"], "question": "When did Western Europe actually start to become rich?", "lenses": ["disease", "economy", "ideas"], "sources": [{"src": "src:broadberry_2015_british", "cite": "Broadberry et al. 2015"}, {"src": "src:allen_2001_great", "cite": "Allen 2001"}, {"src": "src:allen_2009_british", "cite": "Allen 2009"}, {"src": "src:crafts_1985_british", "cite": "Crafts 1985"}, {"src": "src:mpd_2020_maddison", "cite": "Bolt and van Zanden 2020"}, {"src": "src:maddison_2001_world", "cite": "Maddison 2001"}], "status": "sourced"}
{"id": "chain:modern_coal_to_steam", "kind": "chain", "name": "Coal under the feet", "blurb": "Cheap coal made fuel-hungry engines pay in Britain; steam freed industry from rivers and put it on rails.", "start": 1700, "end": 1913, "links": ["rel:why:modern:coal_steam_allen", "rel:why:modern:steam_ir_allen", "rel:why:modern:ir_divergence_clark"], "debates": ["debate:why_industrial_revolution_britain", "debate:when_western_europe_rich"], "question": "Why did the Industrial Revolution begin in Britain?", "lenses": ["geography", "ideas", "economy"], "sources": [{"src": "src:allen_2009_british", "cite": "Allen 2009"}, {"src": "src:clark_2007_farewell", "cite": "Clark 2007"}], "status": "sourced"}
{"id": "chain:modern_hail_to_bastille", "kind": "chain", "name": "From a hailstorm to the Bastille", "blurb": "Drought and hail ruined the 1788 harvest, the loaf peaked on 14 July 1789, and the panic that followed in the countryside ended feudalism in one night.", "start": 1788, "end": 1789, "links": ["rel:why:modern:hail_harvest_neumann", "rel:why:modern:harvest_bread_rude", "rel:why:modern:bread_bastille_rude", "rel:why:modern:bastille_fear_lefebvre", "rel:why:modern:fear_august_lefebvre"], "debates": ["debate:french_revolution_causes"], "question": "What caused the French Revolution?", "lenses": ["geography", "economy", "order", "law"], "sources": [{"src": "src:neumann_1990_great", "cite": "Neumann and Dettwiller 1990"}, {"src": "src:rude_1959_crowd", "cite": "Rudé 1959"}, {"src": "src:kaplan_1976_bread", "cite": "Kaplan 1976"}, {"src": "src:lefebvre_1973_great", "cite": "Lefebvre 1973"}, {"src": "src:lefebvre_1947_coming", "cite": "Lefebvre 1947"}], "status": "sourced"}
{"id": "chain:modern_tambora_cold_summer", "kind": "chain", "name": "A volcano and a cold summer", "blurb": "Tambora's ash veil chilled 1816, harvests rotted, grain prices doubled and families floated down the Rhine toward America; in Geneva the rain produced Frankenstein.", "start": 1815, "end": 1818, "links": ["rel:why:modern:tambora_summer_raible", "rel:why:modern:summer_harvest_post", "rel:why:modern:harvest_crisis_post", "rel:why:modern:crisis_emigration_post", "rel:why:modern:summer_frankenstein_shelley"], "debates": [], "question": "What did the Tambora eruption do to the world?", "lenses": ["geography", "economy", "population", "literature"], "sources": [{"src": "src:raible_2016_tambora", "cite": "Raible et al. 2016"}, {"src": "src:bronnimann_2016_tambora", "cite": "Brönnimann and Krämer 2016"}, {"src": "src:post_1977_last", "cite": "Post 1977"}, {"src": "src:shelley_1831_frankenstein", "cite": "Shelley 1831"}, {"src": "src:wood_2014_tambora", "cite": "Wood 2014"}], "status": "sourced"}
{"id": "chain:modern_blight_to_exodus", "kind": "chain", "name": "From blight to exodus", "blurb": "A mould from the Americas destroyed the potato; hunger and fever killed about a million, and relief rules that cost people their land sent more onto the ships.", "start": 1845, "end": 1855, "links": ["rel:why:modern:blight_famine_ograda", "rel:why:modern:famine_emigration_ograda", "rel:why:modern:gregory_evictions_kinealy", "rel:why:modern:evictions_emigration_donnelly"], "debates": ["debate:irish_famine_causes"], "question": "Why did a million people die in the Irish famine?", "lenses": ["disease", "population", "law", "order"], "sources": [{"src": "src:ograda_1999_black", "cite": "Ó Gráda 1999"}, {"src": "src:yoshida_2013_rise", "cite": "Yoshida et al. 2013"}, {"src": "src:kinealy_1994_this", "cite": "Kinealy 1994"}, {"src": "src:donnelly_2001_great", "cite": "Donnelly 2001"}], "status": "sourced"}
{"id": "chain:modern_el_nino_famines", "kind": "chain", "name": "One ocean, three famines", "blurb": "The El Niño of 1876-77 failed the monsoon in India; harsh relief multiplied the dying, and the scandal produced the Famine Codes.", "start": 1876, "end": 1883, "links": ["rel:why:modern:enso_india_davis", "rel:why:modern:famine_codes_hallmatthews", "rel:why:modern:lytton_india_davis"], "debates": ["debate:late_victorian_famines"], "question": "Were the famines of 1876-79 acts of nature or of policy?", "lenses": ["geography", "population", "law"], "sources": [{"src": "src:davis_2001_late", "cite": "Davis 2001"}, {"src": "src:hallmatthews_2005_peasants", "cite": "Hall-Matthews 2005"}], "status": "sourced"}
{"id": "chain:modern_sarajevo_to_revolution", "kind": "chain", "name": "Thirty-seven days and after", "blurb": "A murder in Sarajevo, a promise from Berlin, an ultimatum from Vienna, Russian mobilisation, world war, and in 1917 revolution in Petrograd.", "start": 1914, "end": 1917, "links": ["rel:why:modern:assassination_cheque_otte", "rel:why:modern:cheque_ultimatum_fischer", "rel:why:modern:ultimatum_mobilisation_mcmeekin", "rel:why:modern:mobilisation_war_taylor", "rel:why:modern:war_revolution_figes"], "debates": ["debate:ww1_origins"], "question": "Who started the First World War?", "lenses": ["order", "military"], "sources": [{"src": "src:otte_2014_july", "cite": "Otte 2014"}, {"src": "src:fischer_1967_germanys", "cite": "Fischer 1967"}, {"src": "src:mombauer_2002_origins", "cite": "Mombauer 2002"}, {"src": "src:mcmeekin_2011_russian", "cite": "McMeekin 2011"}, {"src": "src:taylor_1969_war", "cite": "Taylor 1969"}, {"src": "src:figes_1996_peoples", "cite": "Figes 1996"}], "status": "sourced"}
{"id": "chain:modern_war_gold_hitler", "kind": "chain", "name": "From the trenches to the gold standard to Hitler", "blurb": "The war broke the gold standard; its brittle restoration spread deflation, the slump fed the Nazi vote, and Nazi war opened the way to genocide.", "start": 1914, "end": 1945, "links": ["rel:why:modern:war_gold_eichengreen", "rel:why:modern:gold_depression_eichengreen", "rel:why:modern:depression_nazis_king", "rel:why:modern:nazis_war_kershaw", "rel:why:modern:war_madagascar_browning", "rel:why:modern:madagascar_holocaust_mommsen"], "debates": ["debate:great_depression_causes", "debate:holocaust_decision"], "question": "How did the First World War lead to the Depression, the Second World War and the Holocaust?", "lenses": ["military", "economy", "order", "law", "population"], "sources": [{"src": "src:eichengreen_1992_golden", "cite": "Eichengreen 1992"}, {"src": "src:bernanke_1995_macroeconomics", "cite": "Bernanke 1995"}, {"src": "src:king_2008_ordinary", "cite": "King et al. 2008"}, {"src": "src:kershaw_2000_hitler", "cite": "Kershaw 2000"}, {"src": "src:browning_2004_origins", "cite": "Browning 2004"}, {"src": "src:mommsen_1991_weimar", "cite": "Mommsen 1991"}], "status": "sourced"}
{"id": "chain:modern_cold_war_origins", "kind": "chain", "name": "From victory to Cold War", "blurb": "Where the Red Army stood, communists ruled; Kennan explained Moscow, Truman pledged to contain it, and the rivalry set hard.", "start": 1945, "end": 1950, "links": ["rel:why:modern:war_takeover_gaddis", "rel:why:modern:takeover_telegram_gaddis", "rel:why:modern:telegram_truman_gaddis", "rel:why:modern:truman_coldwar_leffler"], "debates": ["debate:cold_war_origins"], "question": "Who started the Cold War?", "lenses": ["military", "order", "ideas"], "sources": [{"src": "src:gaddis_1997_we", "cite": "Gaddis 1997"}, {"src": "src:gaddis_1972_united", "cite": "Gaddis 1972"}, {"src": "src:kennan_1946_long", "cite": "Kennan 1946"}, {"src": "src:leffler_1992_preponderance", "cite": "Leffler 1992"}], "status": "sourced"}
{"id": "chain:modern_oil_to_collapse", "kind": "chain", "name": "From an oil glut to a hunting lodge", "blurb": "Cheap oil and a self-made deficit emptied Soviet shops; hardliners tried a coup, Ukraine voted to leave, and three leaders signed the Union away.", "start": 1986, "end": 1991, "links": ["rel:why:modern:oil_budget_gaidar", "rel:why:modern:budget_coup_kotkin", "rel:why:modern:coup_referendum_plokhy", "rel:why:modern:referendum_belovezha_plokhy", "rel:why:modern:belovezha_end_plokhy"], "debates": ["debate:soviet_collapse"], "question": "Why did the Soviet Union collapse in 1991?", "lenses": ["economy", "order", "law"], "sources": [{"src": "src:gaidar_2007_collapse", "cite": "Gaidar 2007"}, {"src": "src:kotkin_2001_armageddon", "cite": "Kotkin 2001"}, {"src": "src:plokhy_2014_last", "cite": "Plokhy 2014"}], "status": "sourced"}
{"id": "chain:modern_war_to_partition", "kind": "chain", "name": "From world war to partition", "blurb": "War jailed Congress and built up the League; elections, a failed federal plan and the killing in Calcutta led to a rushed partition and one of history's largest migrations.", "start": 1939, "end": 1951, "links": ["rel:why:modern:war_quitindia_khan", "rel:why:modern:quitindia_elections_khan", "rel:why:modern:elections_cabinet_jalal", "rel:why:modern:cabinet_directaction_jalal", "rel:why:modern:directaction_mountbatten_khan", "rel:why:modern:mountbatten_partition_khan", "rel:why:modern:partition_migration_khan"], "debates": ["debate:partition_of_india"], "question": "Why was India partitioned, and why so violently?", "lenses": ["military", "order", "law", "population"], "sources": [{"src": "src:khan_2007_great", "cite": "Khan 2007"}, {"src": "src:jalal_1985_sole", "cite": "Jalal 1985"}], "status": "sourced"}
