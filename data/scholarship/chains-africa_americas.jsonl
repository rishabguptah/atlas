{"id": "chain:rainforest_to_zimbabwe", "kind": "chain", "name": "From a rainforest drought to Great Zimbabwe", "blurb": "A drier climate opened a corridor through the forest; farmers crossed it, reached southern Africa, and their cattle wealth became the base of the Zimbabwe state.", "question": "Why did Bantu languages and farming come to cover a third of Africa, and what did they build?", "start": -600, "end": 1450, "links": ["rel:why:africa_americas:rainforest_crisis_corridor", "rel:why:africa_americas:corridor_to_south", "rel:why:africa_americas:south_farmers_cattle", "rel:why:africa_americas:cattle_to_zimbabwe"], "debates": ["debate:bantu_expansion", "debate:great_zimbabwe"], "lenses": ["geography", "population", "economy"], "sources": [{"src": "src:bostoen_2015_paleoclimatic", "cite": "Bostoen et al. 2015"}, {"src": "src:patin_2017_dispersals", "cite": "Patin et al. 2017"}, {"src": "src:koile_2022_bantu", "cite": "Koile et al. 2022"}, {"src": "src:huffman_2009_mapungubwe", "cite": "Huffman 2009"}, {"src": "src:phillipson_2005_archaeology", "cite": "Phillipson 2005"}, {"src": "src:garlake_1978_pastoralism", "cite": "Garlake 1978"}], "status": "sourced"}
{"id": "chain:myth_of_foreign_builders", "kind": "chain", "name": "How a settler myth became a nation’s name", "blurb": "An explorer’s fantasy became settler doctrine, then state censorship, and finally the name of an independent country.", "question": "How does racism rewrite the past, and how is the past taken back?", "start": 1871, "end": 1980, "links": ["rel:why:africa_americas:mauch_to_myth", "rel:why:africa_americas:myth_censorship", "rel:why:africa_americas:censorship_name"], "debates": ["debate:great_zimbabwe"], "lenses": ["geography", "ideas", "order"], "sources": [{"src": "src:garlake_1973_zimbabwe", "cite": "Garlake 1973"}, {"src": "src:chirikure_2021_zimbabwe", "cite": "Chirikure 2021"}], "status": "sourced"}
{"id": "chain:mali_gold_to_the_atlantic", "kind": "chain", "name": "From Mali’s gold to the Atlantic slave trade", "blurb": "Goldfields made Mali rich, Musa’s hajj made it famous, Europe’s mapmakers and bullion-hungry mints sent the Portuguese down the coast, and the gold trade at Elmina opened the first Atlantic slave routes.", "question": "How did West African gold pull Europe into the Atlantic?", "start": 800, "end": 1866, "links": ["rel:why:africa_americas:goldfields_mali", "rel:why:africa_americas:mali_to_hajj", "rel:why:africa_americas:hajj_catalan_atlas", "rel:why:africa_americas:atlas_to_elmina", "rel:why:africa_americas:elmina_atlantic_slaves"], "debates": ["debate:mali_gold", "debate:slave_trade_africa"], "lenses": ["economy", "order", "religion", "ideas", "population"], "sources": [{"src": "src:levtzion_1973_ghana", "cite": "Levtzion 1973"}, {"src": "src:bovill_1958_golden", "cite": "Bovill 1958"}, {"src": "src:gomez_2018_dominion", "cite": "Gomez 2018"}, {"src": "src:levtzion_1981_corpus", "cite": "Levtzion and Hopkins 1981"}, {"src": "src:fauvelle_2018_rhinoceros", "cite": "Fauvelle 2018"}, {"src": "src:green_2019_fistful", "cite": "Green 2019"}, {"src": "src:thornton_1992_africa", "cite": "Thornton 1992"}], "status": "sourced"}
{"id": "chain:sugar_to_mistrust", "kind": "chain", "name": "From sugar in Brazil to mistrust in Africa today", "blurb": "Plantation demand drove the trade, the trade made raiding and kidnapping pay, and the insecurity left a lasting mark on trust.", "question": "Why is Africa poorer than it might have been?", "start": 1501, "end": 2005, "links": ["rel:why:africa_americas:brazil_sugar_trade", "rel:why:africa_americas:trade_insecurity", "rel:why:africa_americas:insecurity_mistrust"], "debates": ["debate:slave_trade_africa", "debate:atlantic_slave_trade_volume"], "lenses": ["economy", "population", "order", "ideas"], "sources": [{"src": "src:eltis_2010_atlas", "cite": "Eltis and Richardson 2010"}, {"src": "src:klein_1999_atlantic", "cite": "Klein 1999"}, {"src": "src:nunn_2011_mistrust", "cite": "Nunn and Wantchekon 2011"}, {"src": "src:equiano_1789_narrative", "cite": "Equiano 1789"}], "status": "sourced"}
{"id": "chain:kongo_to_haiti", "kind": "chain", "name": "From Kongo’s wars to the first abolition", "blurb": "Soldiers captured in Kongo’s wars became the African majority of Saint-Domingue, rose in 1791, forced emancipation in 1793 and abolition across the French empire in 1794.", "question": "How did enslaved people end slavery?", "start": 1750, "end": 1802, "links": ["rel:why:africa_americas:kongo_veterans", "rel:why:africa_americas:africans_uprising", "rel:why:africa_americas:uprising_sonthonax", "rel:why:africa_americas:sonthonax_1794", "rel:why:africa_americas:abolition_toussaint"], "debates": ["debate:haitian_revolution"], "lenses": ["military", "population", "order", "law"], "sources": [{"src": "src:thornton_1993_kongo", "cite": "Thornton 1993"}, {"src": "src:geggus_2002_haitian", "cite": "Geggus 2002"}, {"src": "src:popkin_2010_free", "cite": "Popkin 2010"}, {"src": "src:dubois_2004_avengers", "cite": "Dubois 2004"}, {"src": "src:james_1938_jacobins", "cite": "James 1938"}], "status": "sourced"}
{"id": "chain:mosquitoes_to_louisiana", "kind": "chain", "name": "How mosquitoes sold Louisiana", "blurb": "Napoleon’s army met yellow fever in Saint-Domingue, and with the colony lost he sold Louisiana.", "question": "Can disease decide wars and redraw maps?", "start": 1802, "end": 1803, "links": ["rel:why:africa_americas:leclerc_yellow_fever", "rel:why:africa_americas:yellow_fever_louisiana"], "debates": ["debate:haitian_revolution"], "lenses": ["military", "disease", "order"], "sources": [{"src": "src:mcneill_2010_mosquito", "cite": "McNeill 2010"}, {"src": "src:dubois_2004_avengers", "cite": "Dubois 2004"}], "status": "sourced"}
{"id": "chain:great_dying_to_cold", "kind": "chain", "name": "Did the conquest of the Americas cool the planet?", "blurb": "Old World germs crossed the Atlantic, killed most of central Mexico’s people, forests regrew, CO2 dipped, and a colder Little Ice Age helped bring the seventeenth-century crisis.", "question": "Did the conquest of the Americas cool the planet?", "start": 1300, "end": 1850, "links": ["rel:why:africa_americas:exchange_smallpox", "rel:why:africa_americas:smallpox_to_mexico", "rel:why:africa_americas:smallpox_mexico_collapse", "rel:why:africa_americas:mexico_collapse_regrowth", "rel:why:africa_americas:regrowth_orbis", "rel:why:africa_americas:orbis_little_ice_age", "rel:why:africa_americas:little_ice_age_general_crisis"], "debates": ["debate:americas_population"], "lenses": ["disease", "population", "geography", "order"], "sources": [{"src": "src:crosby_1972_columbian", "cite": "Crosby 1972"}, {"src": "src:crosby_1976_virgin", "cite": "Crosby 1976"}, {"src": "src:diaz_1844_memoirs", "cite": "Díaz del Castillo 1844"}, {"src": "src:cook_1998_born", "cite": "Cook 1998"}, {"src": "src:koch_2019_earth", "cite": "Koch et al. 2019"}, {"src": "src:nevle_2008_fire", "cite": "Nevle and Bird 2008"}, {"src": "src:lewis_2015_anthropocene", "cite": "Lewis and Maslin 2015"}, {"src": "src:ruddiman_2003_anthropogenic", "cite": "Ruddiman 2003"}, {"src": "src:parker_2013_global", "cite": "Parker 2013"}], "status": "sourced"}
{"id": "chain:hegemony_to_altepetl", "kind": "chain", "name": "How the Aztec empire fell to its neighbours", "blurb": "An empire that ruled by tribute left enemies at its door; Tlaxcala allied with Cortés, the alliance took Tenochtitlan, and the local city-states lived on.", "question": "How did a few hundred Spaniards topple the Aztecs?", "start": 1429, "end": 1650, "links": ["rel:why:africa_americas:hegemony_tlaxcala", "rel:why:africa_americas:tlaxcala_tenochtitlan", "rel:why:africa_americas:tenochtitlan_altepetl"], "debates": ["debate:spanish_conquest"], "lenses": ["order", "military"], "sources": [{"src": "src:hassig_1988_warfare", "cite": "Hassig 1988"}, {"src": "src:hassig_1994_mexico", "cite": "Hassig 1994"}, {"src": "src:restall_2003_seven", "cite": "Restall 2003"}, {"src": "src:matthew_2007_indian", "cite": "Matthew and Oudijk 2007"}, {"src": "src:lockhart_1992_nahuas", "cite": "Lockhart 1992"}], "status": "sourced"}
{"id": "chain:epidemic_to_taki_onqoy", "kind": "chain", "name": "From an epidemic to the dancing sickness", "blurb": "An epidemic killed the Inca and his heir, civil war followed, Pizarro seized the victor at Cajamarca, Cusco fell, and a generation later Andean prophets preached that the huacas would return.", "question": "How did the Inca empire fall, and how did Andean people respond?", "start": 1524, "end": 1572, "links": ["rel:why:africa_americas:epidemic_inca_war", "rel:why:africa_americas:inca_war_cajamarca", "rel:why:africa_americas:cajamarca_cusco", "rel:why:africa_americas:conquest_taki_onqoy"], "debates": ["debate:spanish_conquest"], "lenses": ["disease", "order", "military", "religion"], "sources": [{"src": "src:hemming_1970_conquest", "cite": "Hemming 1970"}, {"src": "src:rostworowski_1999_inca", "cite": "Rostworowski de Diez Canseco 1999"}, {"src": "src:sarmiento_1907_history", "cite": "Sarmiento de Gamboa 1907"}, {"src": "src:wachtel_1977_vision", "cite": "Wachtel 1977"}, {"src": "src:stern_1982_peru", "cite": "Stern 1982"}], "status": "sourced"}
{"id": "chain:inca_labour_to_china", "kind": "chain", "name": "From Inca labour service to Chinese taxes", "blurb": "Inca rotating labour became the Potosí mita, the mita drove the silver boom, and the silver went to China, which taxed in silver.", "question": "How did Andean labour finance the first global economy?", "start": 1438, "end": 1650, "links": ["rel:why:africa_americas:cusco_storehouses", "rel:why:africa_americas:storehouses_mita", "rel:why:africa_americas:mita_silver", "rel:why:africa_americas:silver_whip"], "debates": ["debate:potosi_silver", "debate:spanish_conquest"], "lenses": ["order", "economy", "law"], "sources": [{"src": "src:murra_1980_economic", "cite": "Murra 1980"}, {"src": "src:daltroy_2002_incas", "cite": "D'Altroy 2002"}, {"src": "src:bakewell_1984_miners", "cite": "Bakewell 1984"}, {"src": "src:cole_1985_mita", "cite": "Cole 1985"}, {"src": "src:vonglahn_1996_fountain", "cite": "von Glahn 1996"}], "status": "sourced"}
{"id": "chain:drying_war_kings", "kind": "chain", "name": "Drying, war and the fall of the Maya kings", "blurb": "Rainfall declined after 660, war escalated, divine kings lost their hold, the southern cities emptied and power moved north to Chichen Itza.", "question": "Why do civilisations collapse?", "start": 660, "end": 1000, "links": ["rel:why:africa_americas:drying_warfare", "rel:why:africa_americas:warfare_kingship", "rel:why:africa_americas:kingship_collapse", "rel:why:africa_americas:collapse_chichen"], "debates": ["debate:maya_collapse"], "lenses": ["geography", "military", "religion", "order", "art"], "sources": [{"src": "src:kennett_2012_development", "cite": "Kennett 2012"}, {"src": "src:demarest_2004_maya", "cite": "Demarest 2004"}, {"src": "src:martin_2000_chronicle", "cite": "Martin and Grube 2000"}, {"src": "src:webster_2002_fall", "cite": "Webster 2002"}, {"src": "src:mcanany_2010_questioning", "cite": "McAnany and Yoffee 2010"}, {"src": "src:aimers_2007_collapse", "cite": "Aimers 2007"}], "status": "sourced"}
{"id": "chain:egypt_to_red_rubber", "kind": "chain", "name": "From Egypt’s debts to the Congo’s red rubber", "blurb": "Egypt’s bankruptcy provoked a nationalist revolt, Britain invaded, rivals rushed into Africa, Berlin handed the Congo to Leopold, and forced rubber collection emptied villages.", "question": "Why did Europe carve up Africa in twenty years, and at what cost?", "start": 1876, "end": 1920, "links": ["rel:why:africa_americas:bankruptcy_urabi", "rel:why:africa_americas:urabi_tel_el_kebir", "rel:why:africa_americas:egypt_chain_reaction", "rel:why:africa_americas:scramble_berlin", "rel:why:africa_americas:berlin_leopold", "rel:why:africa_americas:leopold_red_rubber", "rel:why:africa_americas:rubber_depopulation"], "debates": ["debate:scramble_for_africa"], "lenses": ["economy", "order", "military", "law", "population"], "sources": [{"src": "src:robinson_1961_victorians", "cite": "Robinson and Gallagher 1961"}, {"src": "src:hopkins_1986_victorians", "cite": "Hopkins 1986"}, {"src": "src:pakenham_1991_scramble", "cite": "Pakenham 1991"}, {"src": "src:hochschild_1998_leopold", "cite": "Hochschild 1998"}, {"src": "src:casement_1904_report", "cite": "Casement 1904"}], "status": "sourced"}
