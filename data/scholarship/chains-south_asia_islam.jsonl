{"id": "chain:delhi_cycle", "kind": "chain", "name": "From Mongol raids to a divided north", "blurb": "The Mongol threat forced Delhi to centralise revenue; the centralised state overreached into the Deccan, broke apart into regional sultanates, and a divided north fell to Babur.", "start": 1221, "end": 1526, "links": ["rel:why:south_asia_islam:mongols_fiscal_centralise", "rel:why:south_asia_islam:fiscal_tughluq", "rel:why:south_asia_islam:tughluq_breakaway", "rel:why:south_asia_islam:breakaway_panipat"], "debates": ["debate:india_rarely_consolidated"], "question": "Why did India rarely consolidate?", "lenses": ["military", "law", "order"], "sources": [{"src": "src:jackson_1999_delhi", "cite": "Jackson 1999"}, {"src": "src:eaton_2019_india", "cite": "Eaton 2019"}, {"src": "src:babur_beveridge_1922", "cite": "Babur 1922"}], "status": "sourced"}
{"id": "chain:silver_to_succession_wars", "kind": "chain", "name": "Silver, jagirs and the unravelling of the Mughal empire", "blurb": "American silver let the Mughals pay nobles in cash and rotate them; rotation made nobles squeeze peasants, revolts shrank the paying land, and the scramble for jagirs ended in succession wars and successor states.", "start": 1580, "end": 1760, "links": ["rel:why:south_asia_islam:silver_monetisation", "rel:why:south_asia_islam:monetisation_mansabdari", "rel:why:south_asia_islam:mansabdari_revenue_pressure", "rel:why:south_asia_islam:revenue_revolts", "rel:why:south_asia_islam:revolts_jagir_crisis", "rel:why:south_asia_islam:jagir_factions", "rel:why:south_asia_islam:succession_successors"], "debates": ["debate:india_rarely_consolidated", "debate:mughal_decline"], "question": "Why did India rarely consolidate?", "lenses": ["economy", "law", "order"], "sources": [{"src": "src:moosvi_1987_silver", "cite": "Moosvi 1987"}, {"src": "src:haider_1996_precious", "cite": "Haider 1996"}, {"src": "src:habib_1963_agrarian", "cite": "Habib 1963"}, {"src": "src:richards_1993_mughal", "cite": "Richards 1993"}, {"src": "src:chandra_1959_parties", "cite": "Chandra 1959"}, {"src": "src:alam_1986_crisis", "cite": "Alam 1986"}, {"src": "src:keene_1887_fall", "cite": "Keene 1887"}], "status": "sourced"}
{"id": "chain:provinces_to_paramountcy", "kind": "chain", "name": "Provincial wealth, Indian bankers and the Company's conquest", "blurb": "Mughal money enriched the provinces; their governors became kings, financed by bankers who then backed the East India Company, which unified India with Indian capital and Indian soldiers.", "start": 1650, "end": 1818, "links": ["rel:why:south_asia_islam:monetisation_regional_growth", "rel:why:south_asia_islam:regional_growth_successors", "rel:why:south_asia_islam:successors_portfolio", "rel:why:south_asia_islam:portfolio_company", "rel:why:south_asia_islam:company_paramountcy"], "debates": ["debate:india_rarely_consolidated", "debate:mughal_decline"], "question": "Why did India rarely consolidate?", "lenses": ["economy", "order", "military"], "sources": [{"src": "src:bayly_1983_rulers", "cite": "Bayly 1983"}, {"src": "src:moosvi_1987_economy", "cite": "Moosvi 1987"}, {"src": "src:alam_1986_crisis", "cite": "Alam 1986"}, {"src": "src:subrahmanyam_1988_portfolio", "cite": "Subrahmanyam and Bayly 1988"}, {"src": "src:bayly_1988_indian", "cite": "Bayly 1988"}, {"src": "src:marshall_1987_bengal", "cite": "Marshall 1987"}], "status": "sourced"}
{"id": "chain:drought_to_swadeshi", "kind": "chain", "name": "From drought to boycott: the end of Indian cloth", "blurb": "Droughts raised grain prices and weavers' costs, Lancashire finished the handloom export trade, and the ruin of the weavers became the founding grievance of economic nationalism and the boycott of British cloth.", "start": 1789, "end": 1911, "links": ["rel:why:south_asia_islam:el_nino_1789_grain", "rel:why:south_asia_islam:grain_prices_handloom", "rel:why:south_asia_islam:handloom_drain_theory", "rel:why:south_asia_islam:drain_swadeshi"], "debates": ["debate:indian_deindustrialisation_drain"], "question": "Did British rule deindustrialise India?", "lenses": ["geography", "economy", "ideas", "order"], "sources": [{"src": "src:grove_2007_great", "cite": "Grove 2007"}, {"src": "src:clingingsmith_2008_deindustrialization", "cite": "Clingingsmith and Williamson 2008"}, {"src": "src:chandra_1966_rise", "cite": "Chandra 1966"}, {"src": "src:dutt_1902_economic", "cite": "Dutt 1902"}, {"src": "src:sarkar_1973_swadeshi", "cite": "Sarkar 1973"}], "status": "sourced"}
{"id": "chain:doctrine_to_famine_codes", "kind": "chain", "name": "From Malthus to the famine codes", "blurb": "Laissez-faire doctrine shaped a stingy relief policy, the 1876-78 famine killed millions, and the scandal produced famine codes that, with railways, cut famine deaths after 1908.", "start": 1860, "end": 1940, "links": ["rel:why:south_asia_islam:doctrine_lytton", "rel:why:south_asia_islam:lytton_famine", "rel:why:south_asia_islam:famine_1876_codes", "rel:why:south_asia_islam:codes_mortality_decline"], "debates": ["debate:colonial_famines_india"], "question": "Were colonial famines natural or man-made?", "lenses": ["ideas", "law", "population"], "sources": [{"src": "src:ambirajan_1976_malthusian", "cite": "Ambirajan 1976"}, {"src": "src:ambirajan_1978_classical", "cite": "Ambirajan 1978"}, {"src": "src:davis_2001_late", "cite": "Davis 2001"}, {"src": "src:mcalpin_1983_subject", "cite": "McAlpin 1983"}, {"src": "src:hallmatthews_2005_peasants", "cite": "Hall-Matthews 2005"}], "status": "sourced"}
{"id": "chain:war_to_malaria_1943", "kind": "chain", "name": "War prices to malaria: Bengal 1943", "blurb": "Wartime inflation priced labourers out of rice, the famine followed, and malaria and cholera killed the weakened survivors.", "start": 1942, "end": 1944, "links": ["rel:why:south_asia_islam:inflation_entitlements", "rel:why:south_asia_islam:entitlements_famine", "rel:why:south_asia_islam:famine_1943_malaria"], "debates": ["debate:colonial_famines_india"], "question": "Were colonial famines natural or man-made?", "lenses": ["economy", "population", "disease"], "sources": [{"src": "src:sen_1981_poverty", "cite": "Sen 1981"}, {"src": "src:dyson_1991_excess", "cite": "Dyson and Maharatna 1991"}], "status": "sourced"}
{"id": "chain:slave_soldiers_to_empty_iraq", "kind": "chain", "name": "Slave soldiers to an empty Iraq", "blurb": "Slave armies made and killed caliphs, warlords took Baghdad and paid troops with land revenue, assignees let the canals silt, and Iraq emptied long before the Mongols came.", "start": 836, "end": 1400, "links": ["rel:why:south_asia_islam:slavery_samarra", "rel:why:south_asia_islam:samarra_buyids", "rel:why:south_asia_islam:buyids_iqta", "rel:why:south_asia_islam:iqta_sawad", "rel:why:south_asia_islam:sawad_iraq_adams"], "debates": ["debate:islamic_golden_age_end", "debate:mongol_sack_baghdad"], "question": "Why did the Abbasid golden age end?", "lenses": ["military", "order", "law", "geography", "population"], "sources": [{"src": "src:gordon_2001_breaking", "cite": "Gordon 2001"}, {"src": "src:kennedy_2001_armies", "cite": "Kennedy 2001"}, {"src": "src:kennedy_1986_prophet", "cite": "Kennedy 1986"}, {"src": "src:crone_1980_slaves", "cite": "Crone 1980"}, {"src": "src:adams_1965_land", "cite": "Adams 1965"}, {"src": "src:christensen_1993_decline", "cite": "Christensen 1993"}], "status": "sourced"}
{"id": "chain:persian_kings_to_philosophy", "kind": "chain", "name": "Persian kingship to Arabic philosophy", "blurb": "A dynasty from Khurasan adopted Sasanian imperial ideology, which made patronage of Greek learning a royal duty; the translations created Arabic philosophy.", "start": 750, "end": 1000, "links": ["rel:why:south_asia_islam:revolution_sasanian", "rel:why:south_asia_islam:sasanian_translation", "rel:why:south_asia_islam:translation_falsafa"], "debates": ["debate:islamic_golden_age_end"], "question": "Why did the Abbasid golden age happen?", "lenses": ["order", "ideas"], "sources": [{"src": "src:gutas_1998_greek", "cite": "Gutas 1998"}], "status": "sourced"}
{"id": "chain:little_ice_age_to_great_flight", "kind": "chain", "name": "The Little Ice Age and the Great Flight", "blurb": "The coldest decade of the Little Ice Age brought drought to Anatolia, peasants joined the Celali rebels, and the countryside emptied.", "start": 1590, "end": 1610, "links": ["rel:why:south_asia_islam:lia_anatolia", "rel:why:south_asia_islam:drought_celali", "rel:why:south_asia_islam:celali_flight"], "debates": ["debate:ottoman_decline"], "question": "Did the Ottoman Empire decline?", "lenses": ["geography", "order", "population"], "sources": [{"src": "src:white_2011_climate", "cite": "White 2011"}], "status": "sourced"}
{"id": "chain:muskets_to_constitution", "kind": "chain", "name": "Muskets, tax farms and the road to the Ottoman constitution", "blurb": "Musket armies needed cash, cash came from life-term tax farms, tax farmers became provincial magnates, a decentralised army lost to Russia, and defeat drove the reforms that ended in the 1876 constitution.", "start": 1600, "end": 1876, "links": ["rel:why:south_asia_islam:military_shift_malikane", "rel:why:south_asia_islam:malikane_ayan", "rel:why:south_asia_islam:decentralisation_gap_lewis", "rel:why:south_asia_islam:gap_russia", "rel:why:south_asia_islam:russia_abolition", "rel:why:south_asia_islam:abolition_tanzimat", "rel:why:south_asia_islam:tanzimat_constitution"], "debates": ["debate:ottoman_decline"], "question": "Did the Ottoman Empire decline?", "lenses": ["military", "law", "order"], "sources": [{"src": "src:darling_1996_revenue", "cite": "Darling 1996"}, {"src": "src:salzmann_1993_ancien", "cite": "Salzmann 1993"}, {"src": "src:quataert_2000_ottoman", "cite": "Quataert 2000"}, {"src": "src:lewis_1961_emergence", "cite": "Lewis 1961"}, {"src": "src:lewis_1958_some", "cite": "Lewis 1958"}, {"src": "src:aksan_2007_ottoman", "cite": "Aksan 2007"}], "status": "sourced"}
{"id": "chain:megadrought_to_mekong", "kind": "chain", "name": "Megadrought to the Mekong: the end of Angkor", "blurb": "Droughts and floods broke Angkor's interlinked water network, the core slowly emptied, and the court moved south to the river trade.", "start": 1340, "end": 1550, "links": ["rel:why:south_asia_islam:droughts_failure", "rel:why:south_asia_islam:failure_depopulation", "rel:why:south_asia_islam:depopulation_south_shift"], "debates": ["debate:angkor_end"], "question": "Why was Angkor abandoned?", "lenses": ["geography", "population", "order"], "sources": [{"src": "src:buckley_2010_climate", "cite": "Buckley 2010"}, {"src": "src:penny_2018_demise", "cite": "Penny et al. 2018"}, {"src": "src:penny_2019_geoarchaeological", "cite": "Penny et al. 2019"}, {"src": "src:carter_2019_temple", "cite": "Carter et al. 2019"}], "status": "sourced"}
{"id": "chain:cannon_to_toll", "kind": "chain", "name": "Cannon at Calicut, tolls on the ocean", "blurb": "Da Gama's violence led to the battle of Diu, naval supremacy let the Portuguese sell passes, but Asian traders paid or evaded them and revived the Red Sea route.", "start": 1498, "end": 1600, "links": ["rel:why:south_asia_islam:gama_diu", "rel:why:south_asia_islam:diu_cartaz", "rel:why:south_asia_islam:cartaz_continuity_chaudhuri", "rel:why:south_asia_islam:continuity_red_sea"], "debates": ["debate:indian_ocean_europeans"], "question": "Did the Europeans transform Indian Ocean trade?", "lenses": ["economy", "military", "law"], "sources": [{"src": "src:subrahmanyam_1997_career", "cite": "Subrahmanyam 1997"}, {"src": "src:subrahmanyam_1993_portuguese", "cite": "Subrahmanyam 1993"}, {"src": "src:pearson_2003_indian", "cite": "Pearson 2003"}, {"src": "src:chaudhuri_1985_trade", "cite": "Chaudhuri 1985"}, {"src": "src:lane_1940_mediterranean", "cite": "Lane 1940"}], "status": "sourced"}
