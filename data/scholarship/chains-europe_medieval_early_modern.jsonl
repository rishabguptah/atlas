{"id": "chain:cold_sun_to_leviathan", "kind": "chain", "name": "From a cold sky to Leviathan", "blurb": "Cold decades ruined the harvests of the 1640s, bread prices soared, England and France rose against their kings, and an exile in Paris wrote the founding text of the modern state.", "start": 1300, "end": 1653, "links": ["rel:why:europe_medieval_early_modern:cold_ruins_1640s_harvests", "rel:why:europe_medieval_early_modern:dearth_civil_war", "rel:why:europe_medieval_early_modern:civil_war_leviathan", "rel:why:europe_medieval_early_modern:hunger_and_tax_fronde"], "debates": ["debate:general_crisis_17c"], "question": "Did climate cause the seventeenth-century crisis?", "lenses": ["geography", "economy", "order", "ideas"], "sources": [{"src": "src:parker_2013_global", "cite": "Parker 2013"}, {"src": "src:hobbes_1651_leviathan", "cite": "Hobbes 1651"}], "status": "sourced"}
{"id": "chain:plague_to_free_labour", "kind": "chain", "name": "Plague, wages and the end of English serfdom", "blurb": "The Black Death made labour scarce; Parliament tried to freeze wages, peasants revolted in 1381, serfdom faded, and land ended up in big capitalist farms that fed industry.", "start": 1346, "end": 1840, "links": ["rel:why:europe_medieval_early_modern:plague_wage_freeze", "rel:why:europe_medieval_early_modern:wage_law_to_revolt", "rel:why:europe_medieval_early_modern:revolt_ends_bondage", "rel:why:europe_medieval_early_modern:freedom_without_property", "rel:why:europe_medieval_early_modern:capitalist_farms_feed_industry"], "debates": ["debate:brenner_debate"], "question": "Why did north-western Europe take the capitalist road?", "lenses": ["disease", "law", "order", "economy", "ideas"], "sources": [{"src": "src:hatcher_1994_england", "cite": "Hatcher 1994"}, {"src": "src:hilton_1973_bond", "cite": "Hilton 1973"}, {"src": "src:brenner_1976_agrarian", "cite": "Brenner 1976"}, {"src": "src:brenner_1982_agrarian", "cite": "Brenner 1982"}], "status": "sourced"}
{"id": "chain:two_europes", "kind": "chain", "name": "One plague, two Europes", "blurb": "Scarce labour won tenants freedom in England but let Polish and Prussian lords tie peasants to grain estates serving Amsterdam, splitting Europe into core and periphery.", "start": 1346, "end": 1800, "links": ["rel:why:europe_medieval_early_modern:scarcity_ends_bondage", "rel:why:europe_medieval_early_modern:freedom_without_property", "rel:why:europe_medieval_early_modern:abundant_land_binds_labour", "rel:why:europe_medieval_early_modern:serf_east_periphery"], "debates": ["debate:brenner_debate", "debate:black_death_divergence"], "question": "Why did Europe's regions diverge after 1350?", "lenses": ["disease", "law", "economy"], "sources": [{"src": "src:bailey_2014_decline", "cite": "Bailey 2014"}, {"src": "src:brenner_1976_agrarian", "cite": "Brenner 1976"}, {"src": "src:brenner_1982_agrarian", "cite": "Brenner 1982"}, {"src": "src:domar_1970_causes", "cite": "Domar 1970"}, {"src": "src:blum_1957_rise", "cite": "Blum 1957"}, {"src": "src:wallerstein_1974_modern", "cite": "Wallerstein 1974"}], "status": "sourced"}
{"id": "chain:silver_to_celali", "kind": "chain", "name": "Andean silver, a cold decade and the Celali revolts", "blurb": "Silver from Potosí raised prices across the Mediterranean, the Ottoman treasury debased its coin, unpaid soldiers and starving peasants formed the celali bands, and Anatolia emptied.", "start": 1300, "end": 1650, "links": ["rel:why:europe_medieval_early_modern:treasure_drives_prices", "rel:why:europe_medieval_early_modern:cheap_silver_reaches_istanbul", "rel:why:europe_medieval_early_modern:debasement_unpaid_soldiers", "rel:why:europe_medieval_early_modern:celali_great_flight", "rel:why:europe_medieval_early_modern:cold_1590s", "rel:why:europe_medieval_early_modern:drought_feeds_celali"], "debates": ["debate:price_revolution", "debate:general_crisis_17c"], "question": "What brought the Ottoman Empire's 17th-century crisis?", "lenses": ["geography", "economy", "order", "population"], "sources": [{"src": "src:hamilton_1934_american", "cite": "Hamilton 1934"}, {"src": "src:barkan_1975_price", "cite": "Barkan 1975"}, {"src": "src:pamuk_2000_monetary", "cite": "Pamuk 2000"}, {"src": "src:tezcan_2010_second", "cite": "Tezcan 2010"}, {"src": "src:white_2011_climate", "cite": "White 2011"}, {"src": "src:pfister_1999_climatic", "cite": "Pfister & Brázdil 1999"}], "status": "sourced"}
{"id": "chain:ming_silver_fall", "kind": "chain", "name": "The silver tax and the fall of the Ming", "blurb": "Ming taxes in silver pulled American silver across the Pacific; a later shortfall in imports squeezed taxpayers while drought fed the rebels who took Beijing in 1644.", "start": 1300, "end": 1815, "links": ["rel:why:europe_medieval_early_modern:ming_silver_tax_pulls_silver", "rel:why:europe_medieval_early_modern:silver_dependence_vulnerable", "rel:why:europe_medieval_early_modern:silver_slump_ming", "rel:why:europe_medieval_early_modern:cold_ming_drought", "rel:why:europe_medieval_early_modern:drought_topples_ming"], "debates": ["debate:price_revolution", "debate:general_crisis_17c"], "question": "Why did the Ming fall in 1644?", "lenses": ["law", "economy", "order", "geography"], "sources": [{"src": "src:flynn_1995_born", "cite": "Flynn & Giráldez 1995"}, {"src": "src:von_glahn_1996_fountain", "cite": "von Glahn 1996"}, {"src": "src:atwell_1982_international", "cite": "Atwell 1982"}, {"src": "src:atwell_1986_some", "cite": "Atwell 1986"}, {"src": "src:parker_2013_global", "cite": "Parker 2013"}, {"src": "src:zhang_2011_causality", "cite": "Zhang 2011"}], "status": "sourced"}
{"id": "chain:rain_to_pogrom", "kind": "chain", "name": "Rain, famine, plague and pogrom", "blurb": "A colder, wetter climate brought the Great Famine, the famine left a frailer generation for the Black Death, and plague panic turned into massacres of Jews.", "start": 1300, "end": 1353, "links": ["rel:why:europe_medieval_early_modern:cold_rain_1315", "rel:why:europe_medieval_early_modern:famine_children_frail_adults", "rel:why:europe_medieval_early_modern:well_poisoning_pogroms", "rel:why:europe_medieval_early_modern:famine_youth_march"], "debates": ["debate:great_famine_1315", "debate:black_death_divergence"], "question": "How did climate and disease end medieval expansion?", "lenses": ["geography", "population", "disease", "religion"], "sources": [{"src": "src:campbell_2016_great", "cite": "Campbell 2016"}, {"src": "src:jordan_1996_great", "cite": "Jordan 1996"}, {"src": "src:lucas_1930_great", "cite": "Lucas 1930"}, {"src": "src:dewitte_2013_between", "cite": "DeWitte & Slavin 2013"}, {"src": "src:nirenberg_1996_communities", "cite": "Nirenberg 1996"}, {"src": "src:finley_2018_plague", "cite": "Finley & Koyama 2018"}], "status": "sourced"}
{"id": "chain:volcano_to_troubles", "kind": "chain", "name": "A Peruvian volcano and Russia's Time of Troubles", "blurb": "Huaynaputina's eruption chilled the summer of 1601; Russian harvests failed three years running and famine opened the Time of Troubles.", "start": 1600, "end": 1613, "links": ["rel:why:europe_medieval_early_modern:volcano_russian_hunger", "rel:why:europe_medieval_early_modern:famine_troubles"], "debates": ["debate:general_crisis_17c"], "question": "Did climate cause the seventeenth-century crisis?", "lenses": ["geography", "population", "order"], "sources": [{"src": "src:parker_2013_global", "cite": "Parker 2013"}, {"src": "src:white_2017_cold", "cite": "White 2017"}], "status": "sourced"}
{"id": "chain:press_to_peasants_war", "kind": "chain", "name": "From the printing press to the Peasants' War", "blurb": "Gutenberg's method spread to hundreds of towns; towns with presses turned Protestant; Luther's pamphlets and woodcuts carried \"godly law\" to villages that rose in 1525.", "start": 1450, "end": 1648, "links": ["rel:why:europe_medieval_early_modern:mainz_to_200_towns", "rel:why:europe_medieval_early_modern:press_towns_turn_protestant", "rel:why:europe_medieval_early_modern:divine_law_against_lords", "rel:why:europe_medieval_early_modern:theses_to_pamphlets", "rel:why:europe_medieval_early_modern:woodcuts_and_sermons"], "debates": ["debate:printing_reformation"], "question": "How did a new medium change belief and politics?", "lenses": ["ideas", "economy", "religion", "order", "literature"], "sources": [{"src": "src:eisenstein_1979_printing", "cite": "Eisenstein 1979"}, {"src": "src:dittmar_2011_information", "cite": "Dittmar 2011"}, {"src": "src:rubin_2014_printing", "cite": "Rubin 2014"}, {"src": "src:blickle_1981_revolution", "cite": "Blickle 1981"}, {"src": "src:pettegree_2015_brand", "cite": "Pettegree 2015"}, {"src": "src:edwards_1994_printing", "cite": "Edwards 1994"}], "status": "sourced"}
{"id": "chain:guns_to_empire", "kind": "chain", "name": "Cannon, bastions, debt and empire", "blurb": "Cannon forced new fortresses, fortresses forced bigger armies, armies forced fiscal states, and competing gunpowder states pushed overseas, where Atlantic trade enriched merchants who checked their kings.", "start": 1492, "end": 1800, "links": ["rel:why:europe_medieval_early_modern:cannon_beat_walls_bastions", "rel:why:europe_medieval_early_modern:bastions_need_big_armies", "rel:why:europe_medieval_early_modern:war_made_states", "rel:why:europe_medieval_early_modern:tournament_conquers_world", "rel:why:europe_medieval_early_modern:conquest_makes_atlantic_trade", "rel:why:europe_medieval_early_modern:atlantic_constraints"], "debates": ["debate:military_revolution", "debate:atlantic_rise"], "question": "Why did Europe conquer the world?", "lenses": ["ideas", "military", "art", "order", "economy", "law"], "sources": [{"src": "src:parker_1988_military", "cite": "Parker 1988"}, {"src": "src:parker_1976_military", "cite": "Parker 1976"}, {"src": "src:tilly_1990_coercion", "cite": "Tilly 1990"}, {"src": "src:hoffman_2015_why", "cite": "Hoffman 2015"}, {"src": "src:findlay_2007_power", "cite": "Findlay & O'Rourke 2007"}, {"src": "src:acemoglu_2005_rise", "cite": "Acemoglu et al. 2005"}], "status": "sourced"}
{"id": "chain:sugar_to_steam", "kind": "chain", "name": "Sugar, longer hours and steam", "blurb": "Atlantic sugar and tobacco, grown by enslaved Africans, tempted households to work longer for the market; the industrious household fed industry, and industry turned a lead into the Great Divergence.", "start": 1500, "end": 1900, "links": ["rel:why:europe_medieval_early_modern:enslaved_labour_builds_atlantic", "rel:why:europe_medieval_early_modern:colonial_groceries_work", "rel:why:europe_medieval_early_modern:industrious_before_industrial", "rel:why:europe_medieval_early_modern:industry_widens_gap"], "debates": ["debate:atlantic_rise"], "question": "Why the Great Divergence?", "lenses": ["population", "economy", "people", "ideas"], "sources": [{"src": "src:thornton_1992_africa", "cite": "Thornton 1992"}, {"src": "src:mintz_1985_sweetness", "cite": "Mintz 1985"}, {"src": "src:de_vries_2008_industrious", "cite": "de Vries 2008"}, {"src": "src:de_vries_1994_industrial", "cite": "de Vries 1994"}, {"src": "src:allen_2009_british", "cite": "Allen 2009"}, {"src": "src:mokyr_2009_enlightened", "cite": "Mokyr 2009"}], "status": "sourced"}
{"id": "chain:great_dying_chill", "kind": "chain", "name": "The Great Dying and the cold of the 1640s", "blurb": "Old World diseases killed most indigenous Americans; regrowing forests drew down CO2, deepening the Little Ice Age that ruined harvests and fed revolts in 1640s Europe.", "start": 1300, "end": 1850, "links": ["rel:why:europe_medieval_early_modern:old_world_diseases_americas", "rel:why:europe_medieval_early_modern:great_dying_cools", "rel:why:europe_medieval_early_modern:cold_ruins_1640s_harvests", "rel:why:europe_medieval_early_modern:hunger_masaniello"], "debates": ["debate:general_crisis_17c", "debate:atlantic_rise"], "question": "How connected was the early modern world?", "lenses": ["disease", "population", "geography", "economy", "order"], "sources": [{"src": "src:crosby_1972_columbian", "cite": "Crosby 1972"}, {"src": "src:koch_2019_earth", "cite": "Koch et al. 2019"}, {"src": "src:parker_2013_global", "cite": "Parker 2013"}], "status": "sourced"}
{"id": "chain:pirenne_to_parliaments", "kind": "chain", "name": "From Arab silver to self-governing towns", "blurb": "Islamic silver and the slave trade revived Carolingian commerce, Italian merchants scaled it up, towns won self-government and rulers who needed town money summoned parliaments.", "start": 775, "end": 1350, "links": ["rel:why:europe_medieval_early_modern:slave_sales_buy_silver", "rel:why:europe_medieval_early_modern:carolingian_platform_for_italians", "rel:why:europe_medieval_early_modern:merchants_make_towns", "rel:why:europe_medieval_early_modern:towns_force_parliaments"], "debates": ["debate:pirenne_thesis", "debate:feudalism_construct"], "question": "Where did Europe's constraints on rulers come from?", "lenses": ["economy", "people", "order", "law"], "sources": [{"src": "src:mccormick_2001_origins", "cite": "McCormick 2001"}, {"src": "src:pirenne_1925_medieval", "cite": "Pirenne 1925"}, {"src": "src:van_zanden_2012_rise", "cite": "van Zanden et al. 2012"}, {"src": "src:stasavage_2020_decline", "cite": "Stasavage 2020"}], "status": "sourced"}
