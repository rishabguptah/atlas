{"id": "m:population:country_ireland:modern_census", "kind": "measure", "of": "place:country_ireland", "metric": "population", "unit": "people", "points": [[1821, 6801827, 6801827, 7100000], [1831, 7767401, 7767401, 8000000], [1841, 8175124, 8175124, 8400000], [1851, 6552385, 6552385, 6650000], [1861, 5798967, 5798967, 5850000]], "method": "Values are the census totals for Ireland. Low bounds equal the count; high bounds allow for undercounting in the early censuses, which historians suspect especially for 1821 and 1831, and are a judgement, not a published series.", "src": "src:ograda_1999_black", "lenses": ["population"], "sources": [{"src": "src:ograda_1999_black", "cite": "Ó Gráda 1999"}, {"src": "src:mokyr_1983_why", "cite": "Mokyr 1983"}], "status": "sourced"}
{"id": "m:deaths:irish_famine_1845:modern", "kind": "measure", "of": "event:irish_famine_1845", "metric": "deaths", "unit": "people", "points": [[1848, 1000000, 1000000, 1500000]], "method": "Excess deaths 1846-51, plotted at the famine midpoint. About one million is the usual estimate (Ó Gráda); Mokyr's range runs to about 1.5 million. Excess deaths are reconstructed from census cohorts and emigration, not counted.", "src": "src:ograda_1999_black", "lenses": ["population", "disease"], "sources": [{"src": "src:ograda_1999_black", "cite": "Ó Gráda 1999"}, {"src": "src:mokyr_1983_why", "cite": "Mokyr 1983"}], "status": "sourced"}
{"id": "m:deaths:india_famine_1876:modern_davis", "kind": "measure", "of": "event:india_famine_1876", "metric": "deaths", "unit": "people", "points": [[1877, 8200000, 6100000, 10300000]], "method": "Range of excess-mortality estimates for the Indian famine of 1876-79 collected by Davis; the value is the midpoint, not an estimate in its own right.", "src": "src:davis_2001_late", "lenses": ["population"], "sources": [{"src": "src:davis_2001_late", "cite": "Davis 2001"}], "status": "sourced"}
{"id": "m:deaths:china_famine_1876:modern_davis", "kind": "measure", "of": "event:china_famine_1876", "metric": "deaths", "unit": "people", "points": [[1878, 11000000, 9000000, 13000000]], "method": "Range of estimates for the north China famine of 1876-79 (Davis; Edgerton-Tarpley gives 9 to 13 million); the value is the midpoint.", "src": "src:davis_2001_late", "lenses": ["population"], "sources": [{"src": "src:davis_2001_late", "cite": "Davis 2001"}, {"src": "src:edgertontarpley_2008_tears", "cite": "Edgerton-Tarpley 2008"}], "status": "sourced"}
{"id": "m:bread_price:paris:modern_rude", "kind": "measure", "of": "place:paris", "metric": "bread_price", "unit": "sous per 4-pound loaf", "points": [[1787, 9, 8, 9.5], [1788, 11.5, 9, 14.5], [1789, 14.5, 12, 14.5]], "method": "Paris police price of the four-pound loaf. The band is the range within each year; the value is the typical price of the second half of the year (1788 rising from about 9 sous in August, 1789 at 14.5 sous in July).", "src": "src:rude_1959_crowd", "lenses": ["economy"], "sources": [{"src": "src:rude_1959_crowd", "cite": "Rudé 1959"}, {"src": "src:kaplan_1976_bread", "cite": "Kaplan 1976"}], "status": "sourced"}
{"id": "m:unemployment:country_united_states:modern_lebergott", "kind": "measure", "of": "place:country_united_states", "metric": "unemployment", "unit": "share of civilian labour force (%)", "points": [[1929, 3.2], [1930, 8.7], [1931, 15.9], [1932, 23.6], [1933, 24.9, 20.6, 24.9], [1934, 21.7, 16.0, 21.7], [1935, 20.1, 14.2, 20.1], [1936, 16.9, 9.9, 16.9], [1937, 14.3, 9.1, 14.3], [1938, 19.0, 12.5, 19.0], [1939, 17.2, 11.3, 17.2]], "method": "Values are Lebergott's annual unemployment rates; low bounds from 1933 are Darby's series, which counts workers on emergency relief jobs as employed.", "src": "src:lebergott_1964_manpower", "lenses": ["economy", "population"], "sources": [{"src": "src:lebergott_1964_manpower", "cite": "Lebergott 1964"}, {"src": "src:darby_1976_three", "cite": "Darby 1976"}], "status": "sourced"}
{"id": "m:deaths:holocaust:modern", "kind": "measure", "of": "event:modern_holocaust", "metric": "deaths", "unit": "people", "points": [[1945, 5700000, 5100000, 6000000]], "method": "Jewish victims of the Holocaust. Low bound is Hilberg's count of about 5.1 million; most later totals lie between about 5.6 and 6 million. Built from prewar and postwar populations, deportation lists and camp records.", "src": "src:hilberg_1961_destruction", "lenses": ["population", "order"], "sources": [{"src": "src:hilberg_1961_destruction", "cite": "Hilberg 1961"}, {"src": "src:snyder_2010_bloodlands", "cite": "Snyder 2010"}], "status": "sourced"}
{"id": "m:deaths:partition_india:modern", "kind": "measure", "of": "event:modern_partition_of_india_1947", "metric": "deaths", "unit": "people", "points": [[1947, 1000000, 200000, 2000000]], "method": "Deaths in partition violence. Estimates run from about 200,000 (a contemporary British figure) to 2 million; one million is the figure most often cited. No count was made.", "src": "src:khan_2007_great", "lenses": ["population", "order"], "sources": [{"src": "src:khan_2007_great", "cite": "Khan 2007"}, {"src": "src:talbot_2009_partition", "cite": "Talbot and Singh 2009"}], "status": "sourced"}
{"id": "m:displaced:partition_india:modern", "kind": "measure", "of": "event:modern_partition_of_india_1947", "metric": "displaced", "unit": "people", "points": [[1947, 14500000, 10000000, 20000000]], "method": "People displaced across the new borders. The value sums the refugees counted in the 1951 censuses of India and Pakistan (about 7 million each); published estimates range from about 10 to 20 million.", "src": "src:khan_2007_great", "lenses": ["population"], "sources": [{"src": "src:khan_2007_great", "cite": "Khan 2007"}, {"src": "src:talbot_2009_partition", "cite": "Talbot and Singh 2009"}], "status": "sourced"}
